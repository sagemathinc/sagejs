{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sagejs.org/schemas/numerical-capability-manifest-v1.json",
  "title": "Sage.js numerical capability manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "backend", "subject", "bindings", "capabilities", "id"],
  "properties": {
    "schema": { "const": "sagejs.numerical-capability-manifest/v1" },
    "backend": { "$ref": "#/$defs/backend" },
    "subject": { "$ref": "#/$defs/subject" },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["corpus_sha256", "source_bundle_sha256", "adapter_sha256", "artifacts"],
      "properties": {
        "corpus_sha256": { "$ref": "#/$defs/sha256" },
        "source_bundle_sha256": { "$ref": "#/$defs/sha256" },
        "adapter_sha256": { "$ref": "#/$defs/sha256" },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/artifact" }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/capability" }
    },
    "id": { "$ref": "#/$defs/contentId" }
  },
  "$defs": {
    "nonempty": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "contentId": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/nonempty" },
        "version": { "$ref": "#/$defs/nonempty" }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "version", "engine"],
      "properties": {
        "kind": { "enum": ["node", "npm", "sea", "browser", "worker", "other"] },
        "name": { "$ref": "#/$defs/nonempty" },
        "version": { "$ref": "#/$defs/nonempty" },
        "engine": { "type": ["string", "null"] }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256"],
      "properties": {
        "name": { "$ref": "#/$defs/nonempty" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "reason", "case_ids", "envelope"],
      "properties": {
        "id": { "$ref": "#/$defs/nonempty" },
        "status": { "enum": ["available", "unavailable"] },
        "reason": { "type": ["string", "null"] },
        "case_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonempty" }
        },
        "envelope": { "type": ["object", "null"] }
      }
    }
  }
}
