{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sagejs.org/schemas/numerical-qualification-matrix-policy-v1.json",
  "title": "Sage.js numerical qualification matrix policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "description", "require_clean", "rows"],
  "properties": {
    "schema": { "const": "sagejs.numerical-qualification-matrix-policy/v1" },
    "id": { "$ref": "#/$defs/nonempty" },
    "description": { "$ref": "#/$defs/nonempty" },
    "require_clean": { "type": "boolean" },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/row" }
    }
  },
  "$defs": {
    "nonempty": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "strings": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonempty" }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "match", "required_program_phases", "required_case_layers",
        "required_capabilities", "required_artifacts", "required_memory_scope"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/nonempty" },
        "match": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "corpus_id", "corpus_sha256", "source_bundle_sha256", "capability_manifest_id",
            "backend_id", "backend_version", "platform", "subject_kind", "subject_name",
            "subject_version", "subject_engine"
          ],
          "properties": {
            "corpus_id": { "$ref": "#/$defs/nonempty" },
            "corpus_sha256": { "$ref": "#/$defs/sha256" },
            "source_bundle_sha256": { "$ref": "#/$defs/sha256" },
            "capability_manifest_id": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "backend_id": { "$ref": "#/$defs/nonempty" },
            "backend_version": { "$ref": "#/$defs/nonempty" },
            "platform": { "enum": ["linux-x64", "linux-arm64", "macos-arm64", "windows-x64"] },
            "subject_kind": { "enum": ["node", "npm", "sea", "browser", "worker", "other"] },
            "subject_name": { "$ref": "#/$defs/nonempty" },
            "subject_version": { "$ref": "#/$defs/nonempty" },
            "subject_engine": { "type": ["string", "null"] }
          },
          "allOf": [{
            "if": {
              "properties": { "subject_kind": { "enum": ["browser", "worker"] } },
              "required": ["subject_kind"]
            },
            "then": { "properties": { "subject_engine": { "$ref": "#/$defs/nonempty" } } },
            "else": { "properties": { "subject_engine": { "type": "null" } } }
          }]
        },
        "required_program_phases": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["P0", "P1", "P2", "P3", "P4", "P5", "P6", "P7", "P8"] }
        },
        "required_case_layers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "definition-identity", "independent-residual", "differential-oracle",
              "conditioned-stress", "failure-semantics", "fuzz", "metamorphic"
            ]
          }
        },
        "required_capabilities": { "$ref": "#/$defs/strings" },
        "required_memory_scope": {
          "enum": ["collector_process", "process_tree", "browser_heap"]
        },
        "required_artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "sha256"],
            "properties": {
              "name": { "$ref": "#/$defs/nonempty" },
              "sha256": { "$ref": "#/$defs/sha256" }
            }
          }
        }
      }
    }
  }
}
