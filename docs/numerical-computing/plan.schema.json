{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sagejs.org/schemas/numerical-plan-v1.json",
  "title": "Sage.js NumericalPlan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "problem_digest", "operation", "method", "backend", "selection_reason", "numeric_type", "capability", "fallback", "expected_resources", "rejected_alternatives", "diagnostics"],
  "properties": {
    "schema_version": {"const": 1},
    "problem_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "operation": {"type": "string", "minLength": 1},
    "method": {"type": "string", "minLength": 1},
    "backend": {"type": "string", "minLength": 1},
    "selection_reason": {"type": "string", "minLength": 1},
    "numeric_type": {"type": "string", "minLength": 1},
    "capability": {"type": "object"},
    "fallback": {"type": "object"},
    "expected_resources": {"type": "object"},
    "rejected_alternatives": {"type": "array"},
    "diagnostics": {"type": "array"}
  }
}
