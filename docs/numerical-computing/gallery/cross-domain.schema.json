{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sagejs.org/schemas/numerical-gallery-bundle-v1.json",
  "title": "Sage.js cross-domain numerical teaching gallery",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generation_policy",
    "budgets",
    "story_order",
    "stories",
    "measurements"
  ],
  "properties": {
    "schema": {"const": "sagejs.numerics.gallery.bundle/v1"},
    "generation_policy": {"type": "string", "minLength": 1},
    "budgets": {"$ref": "#/$defs/budgets"},
    "story_order": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "stories": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/story"}
    },
    "measurements": {"$ref": "#/$defs/bundle_measurements"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "positive": {"type": "integer", "minimum": 1},
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_bundle_bytes",
        "max_story_bytes",
        "max_trace_events_per_result",
        "max_trace_bytes_per_result",
        "max_animation_frames",
        "max_scalars_per_frame",
        "max_semantic_animation_bytes",
        "max_plotly_bytes",
        "max_evidence_generation_ms",
        "max_parse_and_budget_validation_ms",
        "max_static_html_generation_ms",
        "max_all_exports_generation_ms",
        "max_browser_hydration_ms",
        "max_single_plot_render_ms"
      ],
      "properties": {
        "max_bundle_bytes": {"$ref": "#/$defs/positive"},
        "max_story_bytes": {"$ref": "#/$defs/positive"},
        "max_trace_events_per_result": {"$ref": "#/$defs/positive"},
        "max_trace_bytes_per_result": {"$ref": "#/$defs/positive"},
        "max_animation_frames": {"$ref": "#/$defs/positive"},
        "max_scalars_per_frame": {"$ref": "#/$defs/positive"},
        "max_semantic_animation_bytes": {"$ref": "#/$defs/positive"},
        "max_plotly_bytes": {"$ref": "#/$defs/positive"},
        "max_evidence_generation_ms": {"$ref": "#/$defs/positive"},
        "max_parse_and_budget_validation_ms": {"$ref": "#/$defs/positive"},
        "max_static_html_generation_ms": {"$ref": "#/$defs/positive"},
        "max_all_exports_generation_ms": {"$ref": "#/$defs/positive"},
        "max_browser_hydration_ms": {"$ref": "#/$defs/positive"},
        "max_single_plot_render_ms": {"$ref": "#/$defs/positive"}
      }
    },
    "story": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "id",
        "domain",
        "operation",
        "title",
        "summary",
        "learning_objectives",
        "method_assumptions",
        "canonical_python",
        "cases",
        "measurements"
      ],
      "properties": {
        "schema": {"const": "sagejs.numerics.gallery.story/v1"},
        "id": {"$ref": "#/$defs/id"},
        "domain": {"type": "string", "minLength": 1},
        "operation": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "learning_objectives": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "method_assumptions": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "canonical_python": {"type": "string", "minLength": 1},
        "cases": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/$defs/case"}
        },
        "measurements": {"type": "object"}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "kind",
        "question",
        "static_description",
        "result",
        "evidence",
        "presentation"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "title": {"type": "string", "minLength": 1},
        "kind": {"enum": ["success", "failure"]},
        "question": {"type": "string", "minLength": 1},
        "static_description": {"type": "string", "minLength": 1},
        "result": {
          "anyOf": [
            {"$ref": "../result.schema.json"},
            {"$ref": "#/$defs/sweep_result"}
          ]
        },
        "reference_comparison": {"$ref": "#/$defs/reference_comparison"},
        "independent_oracle": {"$ref": "#/$defs/independent_oracle"},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^/"}
        },
        "presentation": {
          "anyOf": [{"type": "null"}, {"$ref": "#/$defs/presentation"}]
        },
        "teaching_metrics": {"type": "object"}
      }
    },
    "method_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "value",
        "residual",
        "iterations",
        "evaluations",
        "callback_calls",
        "validation_passed",
        "truth_level"
      ],
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "value": {"type": "number"},
        "residual": {"type": "number", "minimum": 0},
        "iterations": {"type": "integer", "minimum": 0},
        "evaluations": {"type": "integer", "minimum": 0},
        "callback_calls": {"type": "integer", "minimum": 0},
        "validation_passed": {"const": true},
        "truth_level": {"const": "validated_approximate"}
      }
    },
    "reference_comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "claim",
        "primary",
        "reference",
        "agreement",
        "execution",
        "reference_result",
        "evidence"
      ],
      "properties": {
        "schema": {"const": "sagejs.numerics.reference-comparison/v1"},
        "claim": {"type": "string", "minLength": 1},
        "primary": {"$ref": "#/$defs/method_summary"},
        "reference": {"$ref": "#/$defs/method_summary"},
        "agreement": {
          "type": "object",
          "additionalProperties": false,
          "required": ["absolute_value_difference", "threshold", "passed"],
          "properties": {
            "absolute_value_difference": {"type": "number", "minimum": 0},
            "threshold": {"type": "number", "exclusiveMinimum": 0},
            "passed": {"const": true}
          }
        },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "independent_runs",
            "distinct_callback_instances",
            "callback_reevaluated_for_presentation"
          ],
          "properties": {
            "independent_runs": {"const": true},
            "distinct_callback_instances": {"const": true},
            "callback_reevaluated_for_presentation": {"const": false}
          }
        },
        "reference_result": {"$ref": "../result.schema.json"},
        "evidence": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^/"}
        }
      }
    },
    "sweep_trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "events",
        "observed_events",
        "retained_events",
        "dropped_events",
        "retained_bytes"
      ],
      "properties": {
        "events": {"type": "array", "items": {"type": "object"}},
        "observed_events": {"type": "integer", "minimum": 0},
        "retained_events": {"type": "integer", "minimum": 0},
        "dropped_events": {"type": "integer", "minimum": 0},
        "retained_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "sweep_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "parameter",
        "seed",
        "seed_index",
        "credits",
        "status",
        "success",
        "value",
        "error",
        "trace",
        "measurements"
      ],
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "parameter": {},
        "seed": {"type": "integer", "minimum": 0},
        "seed_index": {"type": "integer", "minimum": 0},
        "credits": {"type": "object"},
        "status": {"type": "string", "minLength": 1},
        "success": {"type": "boolean"},
        "value": {
          "anyOf": [
            {"$ref": "../result.schema.json"},
            {"type": "null"}
          ]
        },
        "error": {"type": "object"},
        "trace": {"$ref": "#/$defs/sweep_trace"},
        "measurements": {"type": "object"}
      }
    },
    "sweep_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "operation",
        "plan_digest",
        "status",
        "success",
        "counts",
        "items",
        "measurements",
        "provenance",
        "reproducibility"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "operation": {"const": "parameter_sweep"},
        "plan_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "status": {"type": "string", "minLength": 1},
        "success": {"type": "boolean"},
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["planned", "completed", "failed", "skipped"],
          "properties": {
            "planned": {"type": "integer", "minimum": 0},
            "completed": {"type": "integer", "minimum": 0},
            "failed": {"type": "integer", "minimum": 0},
            "skipped": {"type": "integer", "minimum": 0}
          }
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/sweep_item"}
        },
        "measurements": {"type": "object"},
        "provenance": {"type": "object"},
        "reproducibility": {"type": "object"}
      }
    },
    "sweep_explanation": {
      "type": "object",
      "required": [
        "schema_version",
        "kind",
        "operation",
        "headline",
        "outcome",
        "execution",
        "evidence",
        "interpretation",
        "limitations",
        "provenance"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "kind": {"const": "sweep-explanation"},
        "operation": {"const": "parameter_sweep"},
        "headline": {"type": "string", "minLength": 1},
        "outcome": {"type": "object"},
        "execution": {"type": "object"},
        "evidence": {"type": "object"},
        "interpretation": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "provenance": {"type": "object"}
      }
    },
    "independent_oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "checks", "passed"],
      "properties": {
        "identity": {"type": "string", "minLength": 1},
        "passed": {"const": true},
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "index",
              "rate",
              "observed_final_state",
              "analytic_final_state",
              "absolute_error",
              "tolerance",
              "passed"
            ],
            "properties": {
              "index": {"type": "integer", "minimum": 0},
              "rate": {"type": "number", "exclusiveMinimum": 0},
              "observed_final_state": {"type": "number"},
              "analytic_final_state": {"type": "number"},
              "absolute_error": {"type": "number", "minimum": 0},
              "tolerance": {"type": "number", "exclusiveMinimum": 0},
              "passed": {"const": true}
            }
          }
        }
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "computed_evidence_only",
        "callback_reevaluated",
        "callback_count_before",
        "callback_count_after",
        "public_surface_gap",
        "static_description",
        "plot_spec",
        "plot_animation",
        "plotly"
      ],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "computed_evidence_only": {"const": true},
        "callback_reevaluated": {"const": false},
        "callback_count_before": {"type": ["integer", "null"], "minimum": 0},
        "callback_count_after": {"type": ["integer", "null"], "minimum": 0},
        "public_surface_gap": {"type": ["string", "null"]},
        "static_description": {"type": "string", "minLength": 1},
        "explanation": {"$ref": "#/$defs/sweep_explanation"},
        "plot_spec": {"type": "object"},
        "plot_animation": {"type": ["object", "null"]},
        "plotly": {
          "type": "object",
          "required": ["schema", "source", "shared_lowering", "figure"]
        }
      }
    },
    "bundle_measurements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundle_bytes",
        "story_count",
        "case_count",
        "animated_case_count"
      ],
      "properties": {
        "bundle_bytes": {"$ref": "#/$defs/positive"},
        "story_count": {"$ref": "#/$defs/positive"},
        "case_count": {"$ref": "#/$defs/positive"},
        "animated_case_count": {"$ref": "#/$defs/positive"}
      }
    }
  }
}
