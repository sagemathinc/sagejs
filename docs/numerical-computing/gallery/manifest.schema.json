{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sagejs.org/schemas/numerical-gallery-manifest-v1.json",
  "title": "Sage.js numerical teaching gallery manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "title",
    "description",
    "story_schema",
    "budgets",
    "stories"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "sagejs-numerical-gallery"},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "story_schema": {"type": "string", "minLength": 1},
    "budgets": {"$ref": "#/$defs/budgets"},
    "stories": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/story_entry"}
    }
  },
  "$defs": {
    "positive_integer": {"type": "integer", "minimum": 1},
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_story_bytes",
        "max_trace_events_per_result",
        "max_trace_payload_bytes_per_result",
        "max_animation_frames",
        "max_samples_per_frame",
        "max_animation_payload_bytes"
      ],
      "properties": {
        "max_story_bytes": {"$ref": "#/$defs/positive_integer"},
        "max_trace_events_per_result": {"$ref": "#/$defs/positive_integer"},
        "max_trace_payload_bytes_per_result": {"$ref": "#/$defs/positive_integer"},
        "max_animation_frames": {"$ref": "#/$defs/positive_integer"},
        "max_samples_per_frame": {"$ref": "#/$defs/positive_integer"},
        "max_animation_payload_bytes": {"$ref": "#/$defs/positive_integer"}
      }
    },
    "story_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "domain",
        "operation",
        "status",
        "href",
        "entrypoint",
        "case_ids",
        "capabilities"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "title": {"type": "string", "minLength": 1},
        "domain": {"type": "string", "minLength": 1},
        "operation": {"type": "string", "minLength": 1},
        "status": {"enum": ["complete", "preview", "planned"]},
        "href": {"type": "string", "minLength": 1},
        "entrypoint": {"type": "string", "minLength": 1},
        "case_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "capabilities": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    }
  }
}
