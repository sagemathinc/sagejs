{
  "schema_version": 2,
  "description": "Public Sage programs that must agree across Node and browser WebAssembly hosts.",
  "cases": [
    {
      "id": "exact-big-integer",
      "family": "exact-arithmetic",
      "workflow": "exact-integer-factorization",
      "tier": "routine",
      "requires": [
        { "id": "runtime:integer_factorization", "route": "shared-runtime-js" }
      ],
      "source": "print(2^80 + 17)\nprint(factor(2026))\ncaps = sagejs_capabilities()\nnf_caps = sagejs_capabilities('number-fields')\nworkflow = sagejs_capabilities(workflow='exact-integer-factorization')\nprint(len(caps) >= 900, len(nf_caps) > 0, workflow.available)\ntry:\n    caps[0] = None\nexcept TypeError:\n    print('immutable')",
      "timeout_ms": 15000,
      "expect": {
        "stdout": "1208925819614629174706193\n2 * 1013\nTrue True True\nimmutable\n",
        "repr": ""
      }
    },
    {
      "id": "exact-matrix-and-finite-field-polynomial",
      "family": "exact-arithmetic",
      "workflow": "exact-matrices-and-finite-field-polynomials",
      "tier": "routine",
      "requires": [
        { "id": "ffi:flint:fmpz_matrix_det", "route": "receipt-backed-wasm-artifact" },
        { "id": "ffi:flint:fmpz_matrix_hnf", "route": "receipt-backed-wasm-artifact" },
        { "id": "ffi:flint:fmpz_mod_polynomial_gcd", "route": "receipt-backed-wasm-artifact" }
      ],
      "source": "A = matrix(ZZ, [[1,2],[3,4]])\nR.<x> = PolynomialRing(GF(18446744073709551629))\nf = x^4 + 3*x + 7\nprint(A.det(), A.rank())\nprint(A.hermite_form())\nprint(f.gcd(f.derivative()))",
      "timeout_ms": 20000,
      "expect": {
        "stdout": "-2 2\n[1 0]\n[0 2]\n1\n",
        "repr": ""
      }
    },
    {
      "id": "sagepack-exact-roundtrip",
      "family": "serialization",
      "workflow": "sagepack-exact-roundtrip",
      "tier": "routine",
      "requires": [
        { "id": "specialist:sagepack", "route": "shared-runtime-js" }
      ],
      "source": "from sagejs_serialization import dumps, loads\nA = matrix(QQ, [[1/2,2/3],[3/4,4/5]])\ndata = dumps(A)\nprint(data[:8] == b'SAGEPK1\\x00', loads(data) == A, dumps(loads(data)) == data)",
      "timeout_ms": 15000,
      "expect": {
        "stdout": "True True True\n",
        "repr": ""
      }
    },
    {
      "id": "number-field-maximal-order-prime-zeta",
      "family": "number-fields",
      "workflow": "number-field-maximal-order-prime-zeta",
      "tier": "release",
      "requires": [
        { "id": "kernel:number-field-om-proof-production", "route": "receipt-backed-wasm-artifact" },
        { "id": "kernel:number-field-round4-state-production", "route": "receipt-backed-wasm-artifact" },
        { "id": "kernel:number-field-composite-analysis-production", "route": "receipt-backed-wasm-artifact" },
        { "id": "kernel:number-field-zeta-coefficients-production", "route": "receipt-backed-wasm-artifact" },
        { "id": "napi:@sagemath/sagejs-flint:nfFactorDegreesBatch", "route": "receipt-backed-wasm-artifact" }
      ],
      "source": "R.<x> = QQ[]\nK.<a> = NumberField(x^2 - 5)\nO = K.maximal_order()\nD = O.factor_rational_prime(11)\nprint(K.signature())\nprint([(P.rational_prime(),e,P.residue_class_degree(),P.norm()) for P,e in D])\nprint(K.zeta_function().coefficients(16))",
      "timeout_ms": 60000,
      "expect": {
        "stdout": "(2, 0)\n[(11, 1, 1, 11), (11, 1, 1, 11)]\n[1, 0, 0, 1, 1, 0, 0, 0, 1, 0, 2, 0, 0, 0, 0, 1]\n",
        "repr": ""
      }
    },
    {
