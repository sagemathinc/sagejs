      ],
      "source": "A = matrix(ZZ, [[1,2],[3,4]])\nR.<x> = PolynomialRing(GF(18446744073709551629))\nf = x^4 + 3*x + 7\nprint(A.det(), A.rank())\nprint(A.hermite_form())\nprint(f.gcd(f.derivative()))",
      "timeout_ms": 20000,
