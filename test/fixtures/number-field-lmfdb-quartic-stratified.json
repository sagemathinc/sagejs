  "snapshot": {
    "captured_at": "2026-08-26T21:59:58.597Z",
    "selection_seed": ":sagejs-quartic-36-v1",
    "selection_sql": "COPY (\nWITH base AS (\n  SELECT f.label, f.r2,\n         CASE WHEN f.disc_abs <= 1000000 THEN 0\n              WHEN f.disc_abs <= 10000000 THEN 1\n              ELSE 2 END AS discriminant_band_index,\n         CASE WHEN f.disc_abs <= 1000000 THEN 'd0-1e5-1e6'\n              WHEN f.disc_abs <= 10000000 THEN 'd1-1e6-1e7'\n              ELSE 'd2-1e7-1e8' END AS discriminant_band,\n         CASE WHEN f.class_number = 1 THEN 0\n              WHEN jsonb_array_length(f.class_group) > 1 THEN 3\n              WHEN f.class_number <= 4 THEN 1\n              ELSE 2 END AS class_band_index,\n         CASE WHEN f.class_number = 1 THEN 'h0-trivial'\n              WHEN jsonb_array_length(f.class_group) > 1 THEN 'h3-noncyclic'\n              WHEN f.class_number <= 4 THEN 'h1-cyclic-small'\n              ELSE 'h2-cyclic-large' END AS class_band\n    FROM nf_fields f\n   WHERE f.degree = 4\n     AND f.disc_abs > 100000\n     AND f.disc_abs <= 100000000\n     AND f.class_number IS NOT NULL\n     AND f.class_group IS NOT NULL\n), ranked AS (\n  SELECT base.*,\n         row_number() OVER (\n           PARTITION BY r2, discriminant_band_index, class_band_index\n           ORDER BY md5(label || ':sagejs-quartic-36-v1'), label\n         ) AS selection_rank\n    FROM base\n), selected AS (\n  SELECT label, r2, discriminant_band_index, discriminant_band,\n         class_band_index, class_band, selection_rank,\n         CASE mod(r2 + discriminant_band_index + class_band_index, 3)\n           WHEN 0 THEN 'smoke'\n           WHEN 1 THEN 'tune'\n           ELSE 'holdout' END AS role\n    FROM ranked\n   WHERE selection_rank = 1\n), records AS (\n  SELECT json_build_object(\n           'role', selected.role,\n           'stratum', 'r2-' || selected.r2::text || ':' ||\n             selected.discriminant_band || ':' || selected.class_band,\n           'selection_rank', selected.selection_rank::integer,\n           'discriminant_band_index', selected.discriminant_band_index,\n           'class_band_index', selected.class_band_index\n         ) AS selection,\n         f.label, f.degree,\n         ARRAY(SELECT coefficient::text FROM unnest(f.coeffs) coefficient)\n           AS coefficients,\n         f.disc_sign,\n         f.disc_abs::text AS discriminant_absolute,\n         f.r2,\n         (f.degree - 2 * f.r2)::integer AS r1,\n         (f.degree - f.r2 - 1)::integer AS unit_rank,\n         f.disc_rad::text AS discriminant_radical,\n         f.index::text AS equation_order_index,\n         f.monogenic,\n         f.galt AS galois_transitive_group,\n         f.galois_label,\n         f.num_ram AS ramified_prime_count,\n         f.class_number::text AS class_number,\n         ARRAY(SELECT invariant FROM jsonb_array_elements_text(f.class_group) invariant)\n           AS class_group,\n         f.regulator::text AS regulator,\n         f.torsion_order,\n         f.used_grh,\n         f.narrow_class_number::text AS narrow_class_number,\n         CASE WHEN f.narrow_class_group IS NULL THEN NULL ELSE\n           ARRAY(SELECT invariant::text FROM unnest(f.narrow_class_group) invariant)\n         END AS narrow_class_group,\n         f.unit_signature_rank\n    FROM selected\n    JOIN nf_fields f USING (label)\n   ORDER BY f.degree, f.disc_abs, f.label\n)\nSELECT row_to_json(records) FROM records\n) TO STDOUT;\n",
    "canonical_ordering": [
