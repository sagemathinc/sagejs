{
  "schema_version": 1,
  "numeric_type": "binary64-real",
  "dimension": 1,
  "cases": [
    {
      "id": "polynomial_degree_four",
      "class": "analytic",
      "integrand": "x4",
      "bounds": [0.0, 1.0],
      "expected": 0.2,
      "absolute_acceptance": 1e-13
    },
    {
      "id": "sine_half_period",
      "class": "analytic",
      "integrand": "sin",
      "bounds": [0.0, 3.141592653589793],
      "expected": 2.0,
      "absolute_acceptance": 1e-12
    },
    {
      "id": "reversed_orientation",
      "class": "metamorphic",
      "integrand": "x2",
      "bounds": [1.0, 0.0],
      "expected": -0.3333333333333333,
      "absolute_acceptance": 1e-13
    },
    {
      "id": "known_cusp",
      "class": "pathological",
      "integrand": "cusp_03",
      "bounds": [0.0, 1.0],
      "expected": 0.29,
      "absolute_acceptance": 1e-12,
      "options": {"breakpoints": [0.3]}
    },
    {
      "id": "known_jump",
      "class": "pathological",
      "integrand": "step_025",
      "bounds": [0.0, 1.0],
      "expected": 0.75,
      "absolute_acceptance": 1e-12,
      "options": {"breakpoints": [0.25]}
    },
    {
      "id": "logarithmic_left_endpoint",
      "class": "singular",
