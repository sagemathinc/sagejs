      "absolute_acceptance": 1e-11,
      "options": {"endpoint_singularities": "left"}
    },
    {
      "id": "beta_half_half",
      "class": "singular",
      "integrand": "beta_half",
      "bounds": [0.0, 1.0],
      "expected": 3.141592653589793,
      "absolute_acceptance": 1e-10,
      "options": {"endpoint_singularities": "both"}
    },
    {
      "id": "positive_infinite_exponential",
      "class": "infinite",
