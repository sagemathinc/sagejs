{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sagejs.org/schemas/numerics/linear-algebra-corpus-v1.json",
  "title": "Sage.js backend-neutral dense linear algebra corpus",
  "type": "object",
  "required": ["schema_version", "numeric_type", "cases"],
  "properties": {
    "schema_version": {"const": 1},
    "numeric_type": {"const": "binary64"},
    "description": {"type": "string"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "category", "operation", "matrix"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "category": {
            "enum": ["definition", "conditioned_stress", "metamorphic", "failure"]
          },
          "operation": {
            "enum": ["solve", "least_squares", "rank", "determinant", "inverse", "cholesky"]
          },
          "matrix": {"type": "array"},
          "right": {"type": "array"},
          "expected": {},
          "failure_code": {"type": "string"},
          "absolute_tolerance": {"type": "number", "exclusiveMinimum": 0},
          "oracle": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
