{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sagejs.org/schemas/optimization-engine/complex-cubic-frontier-corpus.schema.json",
  "title": "Content-addressed complex cubic frontier corpus manifest",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "contentId": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "filename",
        "release_url",
        "media_type",
        "content_encoding",
        "record_count",
        "labels_sha256",
        "source_records_sha256",
        "records_sha256",
        "canonical_jsonl_sha256",
        "gzip_sha256",
        "uncompressed_bytes",
        "compressed_bytes"
      ],
      "properties": {
        "role": { "enum": ["survey", "holdout"] },
        "filename": {
          "type": "string",
          "pattern": "^complex-cubic-frontier-(survey|holdout)-sha256-[0-9a-f]{64}\\.jsonl\\.gz$"
        },
        "release_url": { "type": "string", "format": "uri" },
        "media_type": { "const": "application/x-ndjson" },
        "content_encoding": { "const": "gzip" },
        "record_count": { "type": "integer", "minimum": 1 },
        "labels_sha256": { "$ref": "#/$defs/sha256" },
        "source_records_sha256": { "$ref": "#/$defs/sha256" },
        "records_sha256": { "$ref": "#/$defs/sha256" },
        "canonical_jsonl_sha256": { "$ref": "#/$defs/sha256" },
        "gzip_sha256": { "$ref": "#/$defs/sha256" },
        "uncompressed_bytes": { "type": "integer", "minimum": 1 },
        "compressed_bytes": { "type": "integer", "minimum": 1 }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "description",
    "source",
    "snapshot",
    "exclusions",
    "controls",
    "counts",
    "strata",
    "checksums",
    "release"
  ],
  "properties": {
    "schema": {
      "const": "sagejs.number-fields/complex-cubic-frontier-corpus-manifest-v1"
    },
    "id": { "$ref": "#/$defs/contentId" },
    "description": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "dataset",
        "table",
        "number_fields_url",
        "citation_url",
        "public_sql_mirror",
        "license",
        "license_url",
        "columns"
      ],
      "properties": {
        "provider": { "const": "The LMFDB Collaboration" },
        "dataset": { "const": "LMFDB Number Fields" },
        "table": { "const": "nf_fields" },
        "number_fields_url": { "type": "string", "format": "uri" },
        "citation_url": { "type": "string", "format": "uri" },
        "public_sql_mirror": { "type": "string", "format": "uri" },
        "license": { "const": "CC-BY-SA-4.0" },
        "license_url": { "type": "string", "format": "uri" },
        "columns": {
          "type": "array",
          "minItems": 20,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "captured_at",
        "selection_seed",
        "selection_sql",
        "canonical_ordering",
        "discriminant_absolute_lower_exclusive",
        "discriminant_absolute_upper_inclusive"
      ],
      "properties": {
        "captured_at": { "type": "string", "format": "date-time" },
        "selection_seed": {
          "const": ":sagejs-complex-cubic-frontier-1412-v1"
        },
        "selection_sql": { "type": "string", "minLength": 1 },
        "canonical_ordering": {
          "const": ["degree", "numeric-discriminant-absolute", "ascii-label"]
        },
        "discriminant_absolute_lower_exclusive": { "const": "10000" },
        "discriminant_absolute_upper_inclusive": { "const": "100000000" }
      }
    },
    "exclusions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "labels_sha256", "derivation"],
      "properties": {
        "count": { "const": 1815 },
        "labels_sha256": {
          "const": "3aaa2fd01a009d87d40f9f21a83db42b00f3f578827e2ae36d3e0025bdf610d8"
        },
        "derivation": {
          "const": {
            "roots": [
              ".agents/scratch",
              "bench",
              "test/fixtures/number-field-lmfdb-cubic-100.json",
              "test/fixtures/number-field-lmfdb-cubic-class-numbers.json"
            ],
            "label_regex": "3\\.(1|3)\\.[0-9]+\\.[0-9]+",
            "normalization": "discard filename prefixes; sort bytewise unique under LC_ALL=C; serialize one label plus LF"
          }
        }
      }
    },
    "controls": {
      "const": [
        "3.1.23.1",
        "3.1.59.1",
        "3.1.283.1",
        "3.1.588.1",
        "3.1.1083.1",
        "3.1.1371.1",
        "3.1.1563.1",
        "3.1.2856.1",
        "3.1.4027.2",
        "3.1.5448.1",
        "3.1.331.1",
        "3.1.9399.1"
      ]
    },
    "counts": {
      "const": {
        "total": 1412,
        "smoke": 12,
        "tune": 1000,
        "holdout": 400,
        "strata": 20,
        "tune_per_stratum": 50,
        "holdout_per_stratum": 20
      }
    },
    "strata": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "checksums": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "labels_sha256",
        "source_records_sha256",
        "records_sha256",
        "selection_sql_sha256",
        "source_columns_sha256"
      ],
      "properties": {
        "labels_sha256": { "$ref": "#/$defs/sha256" },
        "source_records_sha256": { "$ref": "#/$defs/sha256" },
        "records_sha256": { "$ref": "#/$defs/sha256" },
        "selection_sql_sha256": { "$ref": "#/$defs/sha256" },
        "source_columns_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "assets"],
      "properties": {
        "tag": { "type": "string", "minLength": 1 },
        "assets": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "allOf": [
                { "$ref": "#/$defs/asset" },
                { "properties": { "role": { "const": "survey" } } }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/asset" },
                { "properties": { "role": { "const": "holdout" } } }
              ]
            }
          ],
          "items": false
        }
      }
    }
  }
}
