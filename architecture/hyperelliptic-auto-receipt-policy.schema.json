{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sagejs.org/schemas/hyperelliptic-auto-receipt-policy-v1.json",
  "title": "Sage.js hyperelliptic automatic receipt policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "enabled",
    "required_platforms",
    "source_bundle_contract",
    "source_bundle",
    "entries"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema": { "const": "sagejs.hyperelliptic-auto-receipt-policy/v1" },
    "enabled": { "type": "boolean" },
    "required_platforms": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/platform" }
    },
    "source_bundle_contract": { "$ref": "#/$defs/sourceBundleContract" },
    "source_bundle": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/sourceBundle" }
      ]
    },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "platform": {
      "type": "string",
      "enum": ["linux-x64", "linux-arm64", "darwin-arm64", "win32-x64"]
    },
    "target": {
      "type": "string",
      "enum": ["dynamic", "native", "wasm", "standalone"]
    },
    "safePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9._/-]+$"
    },
    "sourceBundleContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "paths"],
      "properties": {
        "algorithm": { "const": "sagejs.source-bundle-sha256/v1" },
        "paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/safePath" }
        }
      }
    },
    "sourceBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "paths", "sha256", "source_commit"],
      "properties": {
        "algorithm": { "const": "sagejs.source-bundle-sha256/v1" },
        "paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/safePath" }
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "source_commit": { "$ref": "#/$defs/gitCommit" }
      }
    },
    "exactModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "fingerprints"],
      "properties": {
        "kind": { "const": "exact-fingerprint" },
        "fingerprints": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "domainConstraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["genus", "field_kind", "model_kind", "h_kind"],
      "properties": {
        "genus": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1 }
        },
        "field_kind": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "model_kind": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "h_kind": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["zero", "nonzero"] }
        }
      }
    },
    "domainModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "domain_id", "constraints"],
      "properties": {
        "kind": { "const": "domain-envelope" },
        "domain_id": { "$ref": "#/$defs/identifier" },
        "constraints": { "$ref": "#/$defs/domainConstraints" }
      }
    },
    "model": {
      "oneOf": [
        { "$ref": "#/$defs/exactModel" },
        { "$ref": "#/$defs/domainModel" }
      ]
    },
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prime_min",
        "prime_max",
        "interval_start_min",
        "interval_stop_max",
        "interval_span_max",
        "batch_items_min",
        "batch_items_max",
        "scalar_bits_max",
        "resource_bytes_max"
      ],
      "properties": {
        "prime_min": { "type": "integer", "minimum": 0 },
        "prime_max": { "type": "integer", "minimum": 0 },
        "interval_start_min": { "type": "integer", "minimum": 0 },
        "interval_stop_max": { "type": "integer", "minimum": 0 },
        "interval_span_max": { "type": "integer", "minimum": 1 },
        "batch_items_min": { "type": "integer", "minimum": 0 },
        "batch_items_max": { "type": "integer", "minimum": 0 },
        "scalar_bits_max": { "type": "integer", "minimum": 0 },
        "resource_bytes_max": { "type": "integer", "minimum": 0 }
      }
    },
    "evidenceRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "platforms"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/platform" }
        }
      }
    },
    "requiredEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["failures", "sanitizers"],
      "properties": {
        "failures": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceRequirement" }
        },
        "sanitizers": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceRequirement" }
        }
      }
    },
    "receiptReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "path", "sha256"],
      "properties": {
        "platform": { "$ref": "#/$defs/platform" },
        "path": { "$ref": "#/$defs/safePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "fileIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/safePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "enabled",
        "backend",
        "operation",
        "platforms",
        "source_bundle_sha256",
        "corpus",
        "harness",
        "required_targets",
        "exact_result_sha256",
        "model",
        "envelope",
        "required_evidence",
        "receipts"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "enabled": { "type": "boolean" },
        "backend": { "$ref": "#/$defs/identifier" },
        "operation": { "$ref": "#/$defs/identifier" },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/platform" }
        },
        "source_bundle_sha256": { "$ref": "#/$defs/sha256" },
        "corpus": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "path", "sha256"],
          "properties": {
            "id": { "$ref": "#/$defs/identifier" },
            "path": { "$ref": "#/$defs/safePath" },
            "sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "harness": { "$ref": "#/$defs/fileIdentity" },
        "required_targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/target" }
        },
        "exact_result_sha256": { "$ref": "#/$defs/sha256" },
        "model": { "$ref": "#/$defs/model" },
        "envelope": { "$ref": "#/$defs/envelope" },
        "required_evidence": { "$ref": "#/$defs/requiredEvidence" },
        "receipts": {
          "type": "array",
          "items": { "$ref": "#/$defs/receiptReference" }
        }
      }
    }
  }
}
