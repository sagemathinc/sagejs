        "statistics", "struct", "subprocess", "sys", "tempfile", "time",
        "traceback", "types", "urllib", "uuid", "weakref", "zlib"
      ],
      "files": [
        "src/lib/aes.py", "src/lib/array.py", "src/lib/base64.py",
        "src/lib/bisect.py", "src/lib/collections.py", "src/lib/contextlib.py",
        "src/lib/csv.py", "src/lib/elementmaker.py", "src/lib/encodings.py",
        "src/lib/fnmatch.py", "src/lib/functools.py", "src/lib/gc.py",
        "src/lib/genericpath.py", "src/lib/gettext.py", "src/lib/glob.py",
        "src/lib/gzip.py", "src/lib/hashlib.py", "src/lib/heapq.py",
        "src/lib/io.py", "src/lib/js.py", "src/lib/json.py", "src/lib/math.py",
        "src/lib/multiprocessing.py", "src/lib/ntpath.py", "src/lib/operator.py",
        "src/lib/os.py", "src/lib/pathlib.py", "src/lib/posixpath.py",
        "src/lib/pythonize.py", "src/lib/random.py", "src/lib/re.py",
        "src/lib/sagejs_serialization.py", "src/lib/shutil.py",
        "src/lib/socket.py", "src/lib/statistics.py", "src/lib/struct.py",
        "src/lib/subprocess.py", "src/lib/sys.py", "src/lib/tempfile.py",
        "src/lib/time.py", "src/lib/traceback.py", "src/lib/types.py",
        "src/lib/uuid.py", "src/lib/weakref.py", "src/lib/zlib.py"
      ],
      "prefixes": ["src/lib/http/", "src/lib/sage/", "src/lib/urllib/"]
    },
    {
      "id": "numeric-compat",
      "layer": 3,
      "startup": "lazy",
      "max_source_bytes": 26000,
      "depends_on": ["core-runtime", "python-stdlib", "arithmetic", "linear-algebra"],
      "modules": ["mpmath", "numpy"],
      "files": ["src/lib/mpmath.py", "src/lib/numpy.py"],
      "prefixes": []
    },
    {
      "id": "polyglot",
      "layer": 4,
      "startup": "lazy",
      "max_source_bytes": 35000,
      "depends_on": [
        "core-runtime", "python-stdlib", "arithmetic", "symbolics",
        "numeric-compat", "graphics"
      ],
      "modules": ["magma", "maple", "matlab", "wolfram"],
      "files": [
        "src/lib/magma.py", "src/lib/maple.py", "src/lib/matlab.py",
        "src/lib/wolfram.py"
      ],
      "prefixes": []
    }
  ],
  "workspace_packages": [
    {
      "id": "sagejs",
      "path": ".",
      "name": "@sagemath/sagejs",
      "depends_on": ["sagejs-flint"]
    },
    {
      "id": "sagejs-flint",
      "path": "packages/flint",
      "name": "@sagemath/sagejs-flint",
      "depends_on": []
    },
    {
      "id": "sagejs-flint-wasm",
      "path": "packages/flint-wasm",
      "name": "@sagemath/sagejs-flint-wasm",
      "depends_on": []
    }
  ]
}
