{
  "schema_version": 1,
  "policy": {
    "owned_source_roots": ["src/baselib", "src/lib"],
    "owned_typescript_roots": ["tools/serialization-codecs"],
    "new_domains_default_to": "lazy",
    "bootstrap_growth_requires_budget_change": true
  },
  "startup_budgets": {
    "development-cli": {
      "normalized_median_ms": 300,
      "hard_limit_ms": 1500,
      "samples": 11,
      "reference_node_ms": 30
    },
    "sea-cli": {
      "normalized_median_ms": 300,
      "hard_limit_ms": 1500,
      "samples": 11,
      "reference_node_ms": 30
    }
  },
  "packages": [
    {
      "id": "core-runtime",
      "layer": 0,
      "startup": "bootstrap",
      "max_source_bytes": 430000,
      "depends_on": [],
      "modules": ["sagejs", "sagejs.runtime"],
      "files": [
        "src/baselib/__future__.py",
        "src/baselib/builtins.py",
        "src/baselib/byte_strings.py",
        "src/baselib/containers.py",
        "src/baselib/errors.py",
        "src/baselib/internal.py",
        "src/baselib/itertools.py",
        "src/baselib/sagejs_bootstrap.py",
        "src/baselib/str.py"
      ],
      "prefixes": ["src/baselib/sagejs/"]
    },
    {
      "id": "arithmetic",
      "layer": 1,
      "startup": "bootstrap",
      "max_source_bytes": 480000,
      "depends_on": ["core-runtime"],
      "files": [
        "src/baselib/algebra.py",
        "src/baselib/exact_rational.py",
        "src/baselib/factorization.py",
        "src/baselib/finite_fields.py",
        "src/baselib/number_fields.py",
        "src/baselib/padics.py",
        "src/baselib/polynomial.py",
        "src/baselib/real_complex.py",
        "src/baselib/series.py",
        "src/baselib/zeta_data.py",
        "src/baselib/zz_introspection.py"
      ],
      "typescript_files": [
        "tools/serialization-codecs/arithmetic.ts",
        "tools/serialization-codecs/number-fields.ts",
        "tools/serialization-codecs/polynomial.ts",
        "tools/serialization-codecs/series.ts"
      ],
      "prefixes": []
    },
    {
      "id": "linear-algebra",
      "layer": 2,
      "startup": "bootstrap",
      "max_source_bytes": 112000,
      "depends_on": ["core-runtime", "arithmetic"],
      "files": ["src/baselib/matrix.py"],
      "typescript_files": ["tools/serialization-codecs/linear-algebra.ts"],
      "prefixes": []
    },
    {
      "id": "symbolics",
      "layer": 2,
      "startup": "bootstrap",
      "max_source_bytes": 95000,
      "depends_on": ["core-runtime", "arithmetic"],
      "files": ["src/baselib/symbolic.py"],
      "prefixes": []
    },
    {
      "id": "groups-combinatorics",
      "layer": 3,
      "startup": "bootstrap",
      "max_source_bytes": 33000,
      "depends_on": ["core-runtime", "arithmetic", "linear-algebra"],
      "files": ["src/baselib/groups.py"],
      "prefixes": []
    },
    {
      "id": "elliptic-curves",
      "layer": 3,
      "startup": "bootstrap",
      "max_source_bytes": 56000,
      "depends_on": ["core-runtime", "arithmetic"],
      "files": ["src/baselib/elliptic_curves.py"],
      "typescript_files": ["tools/serialization-codecs/elliptic-curves.ts"],
      "prefixes": []
    },
    {
      "id": "elliptic-curves-advanced",
      "layer": 4,
      "startup": "lazy",
      "max_source_bytes": 30000,
      "depends_on": ["core-runtime", "arithmetic", "elliptic-curves"],
      "files": ["src/lib/sagejs_elliptic_advanced.py"],
      "prefixes": []
    },
    {
      "id": "modular-forms",
      "layer": 3,
      "startup": "bootstrap",
      "max_source_bytes": 230000,
      "depends_on": ["core-runtime", "arithmetic", "linear-algebra"],
      "files": ["src/baselib/dirichlet.py", "src/baselib/modular.py"],
      "typescript_files": ["tools/serialization-codecs/modular-forms.ts"],
      "prefixes": []
    },
    {
      "id": "graphics",
      "layer": 3,
      "startup": "bootstrap",
      "max_source_bytes": 320000,
      "depends_on": ["core-runtime", "arithmetic", "symbolics"],
      "files": ["src/baselib/graphics.py", "src/baselib/graphics3d.py"],
      "prefixes": []
