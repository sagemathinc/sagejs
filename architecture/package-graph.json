      "startup": "lazy",
      "max_source_bytes": 420000,
      "depends_on": ["core-runtime"],
      "modules": [
        "aes", "array", "base64", "bisect", "collections", "contextlib",
        "csv", "elementmaker", "encodings", "fnmatch", "functools", "gc",
