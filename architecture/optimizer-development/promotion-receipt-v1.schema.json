{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sagejs.org/schemas/optimizer-development/promotion-receipt-v1.schema.json",
  "title": "Sage.js optimizer promotion receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "authority", "campaign", "intervention", "policy", "baseline", "candidate", "build", "artifact", "workloads", "correctness", "compilerDelta", "routes", "performance", "costs", "resources", "platforms", "baselineExceptions", "browsers", "dashboardDelta", "adversarial", "neighboring", "losingCandidates", "decision"],
  "properties": {
    "schema": { "const": "sagejs.optimizer-promotion-receipt/v1" },
    "id": { "$ref": "wire-definitions-v1.schema.json#/$defs/contentId" },
    "authority": { "const": "promotion-validator" },
    "campaign": { "$ref": "wire-definitions-v1.schema.json#/$defs/reference" },
    "intervention": { "$ref": "opportunity-evidence-v1.schema.json#/properties/intervention" },
    "policy": { "type": "object" },
    "baseline": { "type": "object" },
    "candidate": { "type": "object" },
    "build": { "type": "object" },
    "artifact": { "type": "object" },
    "workloads": { "type": "array", "minItems": 1, "items": { "$ref": "wire-definitions-v1.schema.json#/$defs/contentId" } },
    "correctness": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "compilerDelta": { "type": ["object", "null"] },
    "routes": { "type": "array", "items": { "type": "object" } },
    "performance": { "type": "object" },
    "costs": { "type": "object" },
    "resources": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "platforms": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "baselineExceptions": { "type": "array", "items": { "type": "object" } },
    "browsers": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "object" } },
    "dashboardDelta": { "type": "object" },
    "adversarial": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "neighboring": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "losingCandidates": { "type": "array", "items": { "type": "object" } },
    "decision": { "type": "object" }
  }
}
