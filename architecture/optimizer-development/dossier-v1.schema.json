{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sagejs.org/schemas/optimizer-development/dossier-v1.schema.json",
  "title": "Sage.js optimizer dossier v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "status", "classification", "recommendedAction", "source", "evidence", "excerpt", "currentIr", "facts", "rejections", "costs", "candidates", "unresolvedProofs", "suggestedContract", "witness", "oracles", "adversarialObligations", "benchmarkObligations", "generality", "negativeEvidence", "claims", "integration", "promotionCriteria"],
  "properties": {
    "schema": { "const": "sagejs.optimizer-dossier/v1" },
    "id": { "$ref": "wire-definitions-v1.schema.json#/$defs/contentId" },
    "status": { "enum": ["eligible", "ineligible", "stale", "ambiguous"] },
    "classification": { "enum": ["algorithmic", "representational", "boundary-dominated", "proof-dominated", "unclassified"] },
    "recommendedAction": { "enum": ["already-optimized", "reject", "investigate", "algorithm-work", "compiler-campaign"] },
    "source": { "$ref": "wire-definitions-v1.schema.json#/$defs/source" },
    "evidence": {
      "type": "object",
      "required": ["dashboardId", "overlayId", "profileIds", "opportunityEvidenceIds"]
    },
    "excerpt": { "type": "object" },
    "currentIr": { "type": "object" },
    "facts": { "type": "object" },
    "rejections": { "type": "array", "items": { "$ref": "wire-definitions-v1.schema.json#/$defs/reason" } },
    "costs": { "type": "object" },
    "candidates": { "type": "array", "items": { "type": "object" } },
    "unresolvedProofs": { "type": "array", "items": { "type": "string" } },
    "suggestedContract": { "type": "object" },
    "witness": { "type": "object" },
    "oracles": { "type": "array", "items": { "type": "object" } },
    "adversarialObligations": { "type": "array", "items": { "type": "string" } },
    "benchmarkObligations": { "type": "array", "items": { "type": "string" } },
    "generality": { "type": "array", "items": { "type": "string" } },
    "negativeEvidence": { "type": "array", "items": { "type": "object" } },
    "claims": { "type": "array", "items": { "$ref": "wire-definitions-v1.schema.json#/$defs/repositoryPath" } },
    "integration": { "type": "object" },
    "promotionCriteria": { "type": "object" }
  }
}
