{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sagejs.org/schemas/optimizer-development/campaign-v1.schema.json",
  "title": "Sage.js optimizer campaign v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "status", "baseCommit", "dossier", "intervention", "hypothesis", "selectionEvidence", "interfaces", "targets", "lanes", "dependencies", "oracles", "acceptance", "platforms", "evidencePolicy"],
  "properties": {
    "schema": { "const": "sagejs.optimizer-campaign/v1" },
    "id": { "$ref": "wire-definitions-v1.schema.json#/$defs/contentId" },
    "status": { "enum": ["proposed", "approved", "active", "review", "accepted", "rejected"] },
    "baseCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "dossier": { "$ref": "wire-definitions-v1.schema.json#/$defs/reference" },
    "intervention": { "$ref": "opportunity-evidence-v1.schema.json#/properties/intervention" },
    "hypothesis": { "type": "string", "minLength": 1 },
    "selectionEvidence": { "type": "string", "minLength": 1 },
    "interfaces": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "targets": { "type": "array", "minItems": 1, "items": { "enum": ["v8", "wasm", "native", "library", "generic"] } },
    "lanes": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "oracles": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "acceptance": { "type": "object" },
    "platforms": { "type": "array", "minItems": 1, "items": { "enum": ["linux-x64", "linux-arm64", "windows-x64", "macos-arm64"] } },
    "evidencePolicy": { "type": "object" }
  }
}
