{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sagejs.org/schemas/optimizer-development/hotness-overlay-v1.schema.json",
  "title": "Sage.js optimizer hotness overlay v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "dashboard", "profiles", "opportunities", "joinPolicy", "regions", "unmatched", "summary"],
  "properties": {
    "schema": { "const": "sagejs.optimizer-hotness-overlay/v1" },
    "id": { "$ref": "wire-definitions-v1.schema.json#/$defs/contentId" },
    "dashboard": { "type": "object" },
    "profiles": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "opportunities": { "type": "array", "items": { "type": "object" } },
    "joinPolicy": { "type": "object" },
    "regions": { "type": "array", "items": { "type": "object" } },
    "unmatched": { "type": "array", "items": { "type": "object" } },
    "summary": { "type": "object" }
  }
}
