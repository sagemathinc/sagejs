      "semantic_domain": "exact integers with machine-word specialization and GMP promotion",
      "fallback": "same-source",
      "oracles": ["cpython", "javascript"],
      "benchmark": "bench:native:cowasm",
      "platforms": ["linux-x64", "linux-arm64", "windows-x64", "macos-arm64"]
    },
    {
      "id": "prime-field-witness",
