{
  "schema_version": 1,
  "policy": {
    "implementation": "source-transparent-typed-python",
    "fallback": "same-source",
    "required_introspection": ["explain", "ir", "emit-c", "emit-core-c", "emit-header"],
    "host_isolation": "mandatory-after-marshalling",
    "host_isolation_statuses": ["certified"],
    "required_oracles": ["cpython", "javascript"]
  },
  "kernels": [
    {
      "id": "exact-integer-witness",
      "source": "bench/cowasm/src/native_number_theory.py",
      "functions": ["native_gcd", "native_bench_gcd", "native_bench_large_gcd", "native_rfib"],
      "semantic_domain": "exact integers with machine-word specialization and GMP promotion",
      "fallback": "same-source",
      "host_isolation": "certified",
      "oracles": ["cpython", "javascript"],
      "benchmark": "bench:native:cowasm",
      "platforms": ["linux-x64", "linux-arm64", "windows-x64", "macos-arm64"]
    },
    {
      "id": "prime-field-witness",
      "source": "bench/native_prime_field_source.py",
      "functions": ["source_prime_rank", "source_prime_matmul"],
      "semantic_domain": "source-transparent dense linear algebra over prime fields",
      "fallback": "same-source",
      "host_isolation": "certified",
      "oracles": ["cpython", "javascript", "flint"],
      "benchmark": "bench:native:prime-source",
      "platforms": ["linux-x64", "linux-arm64", "windows-x64", "macos-arm64"]
    },
    {
      "id": "dense-prime-production",
      "source": "src/lib/sagejs/kernels/dense_prime.py",
      "functions": [
        "dense_prime_rank",
        "dense_prime_rref",
        "dense_prime_right_kernel",
        "dense_prime_solve"
      ],
      "semantic_domain": "production rank, RREF, right kernel, and solve over canonical packed GF(p) storage",
      "fallback": "same-source",
      "host_isolation": "certified",
      "oracles": ["cpython", "javascript", "flint", "legacy-napi"],
      "benchmark": "bench:native:dense-prime",
      "platforms": ["linux-x64", "linux-arm64", "windows-x64", "macos-arm64"]
    },
    {
      "id": "packed-binary64-witness",
      "source": "bench/cowasm/native/numerical_buffers.py",
      "functions": ["nbody_advance_energy", "matrix_multiply_repeated"],
      "semantic_domain": "packed binary64 buffers, bounded records, mutation, and nested loops",
      "fallback": "same-source",
      "host_isolation": "certified",
      "oracles": ["cpython", "javascript", "handwritten-c"],
      "benchmark": "bench:cowasm:buffers",
      "platforms": ["linux-x64", "linux-arm64", "windows-x64", "macos-arm64"]
    },
    {
      "id": "tate-algorithm-witness",
      "source": "bench/native_tate_large_prime.py",
      "functions": ["tate_large_prime_invariants", "tate_large_prime"],
      "semantic_domain": "exact control-heavy elliptic-curve reduction at primes greater than three",
      "fallback": "same-source",
      "host_isolation": "certified",
      "oracles": ["cpython", "javascript", "pari"],
      "benchmark": "bench:native:tate",
      "platforms": ["linux-x64", "linux-arm64", "windows-x64", "macos-arm64"]
    },
    {
      "id": "p1-heilbronn-witness",
      "source": "src/lib/sagejs/kernels/p1.py",
      "functions": [
        "p1_gcd",
        "p1_xgcd_left",
        "p1_normalize_with_scalar",
        "p1_round_quotient",
        "heilbronn_cremona_count",
        "heilbronn_cremona_digest",
        "heilbronn_cremona_entry",
        "heilbronn_cremona_fill",
        "heilbronn_merel_digest",
        "heilbronn_merel_entry",
        "heilbronn_merel_fill",
        "p1_monomial_matrix_coefficient",
        "heilbronn_higher_weight_action_fill",
        "p1_index_normalized_packed",
        "p1_apply_packed",
        "heilbronn_coset_transport_fill",
        "heilbronn_transported_action_fill",
        "p1_rational_add_scaled_at",
        "heilbronn_reduce_transported_action",
        "heilbronn_higher_weight_hecke_fill"
      ],
      "semantic_domain": "packed Heilbronn representatives, P1 coset transport, arbitrary-precision polynomial action, and rational quotient reduction used by modular symbols",
      "fallback": "same-source",
      "host_isolation": "certified",
      "oracles": ["cpython", "javascript", "handwritten-c", "flint"],
      "benchmark": "bench:native:p1",
      "platforms": ["linux-x64", "linux-arm64", "windows-x64", "macos-arm64"]
    }
  ]
}
