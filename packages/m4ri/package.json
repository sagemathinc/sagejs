{
  "name": "@sagemath/sagejs-m4ri",
  "version": "0.0.1",
  "description": "Generated M4RI dense GF(2) matrix resources for Sage.js",
  "license": "GPL-2.0-or-later",
  "private": true,
  "type": "commonjs",
  "main": "index.cjs",
  "engines": {
    "node": ">=22.22.2"
  },
  "files": [
    "build/generated-ffi/sagejs_m4ri_ffi.node",
    "build/generated-ffi/manifest.json",
    "generated/ffi_host.py",
    "include",
    "index.cjs",
    "README.md"
  ],
  "scripts": {
    "install": "node scripts/install.cjs",
    "build:deps": "node scripts/build-deps.cjs",
    "build:ffi": "node ../../scripts/build-ffi-host-adapter.cjs m4ri",
    "build": "pnpm run build:deps && pnpm run build:ffi",
    "test": "node --expose-gc --test --test-reporter=spec test/test.cjs",
    "bench": "node bench/benchmark.cjs"
  }
}
