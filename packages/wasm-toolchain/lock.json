{
  "$schema": "./lock.schema.json",
  "schema": "sagejs.wasm-toolchain-lock/v2",
  "sourceCatalog": "../../tools/source-mirror/catalog.json",
  "canonicalBuilder": "linux-x64",
  "wasiSdk": {
    "version": "33.0",
    "target": "wasm32-wasip1",
    "sources": {
      "linux-x64": "wasi-sdk-linux-x64",
      "linux-arm64": "wasi-sdk-linux-arm64",
      "darwin-x64": "wasi-sdk-darwin-x64",
      "darwin-arm64": "wasi-sdk-darwin-arm64"
    }
  },
  "libraries": {
    "gmp": { "version": "6.2.1", "source": "gmp-wasm", "prefix": "prefixes/gmp", "archiveName": "libgmp.a" },
    "mpfr": { "version": "4.2.2", "source": "mpfr", "prefix": "prefixes/mpfr", "archiveName": "libmpfr.a" },
    "mpc": { "version": "1.4.1", "source": "mpc", "prefix": "prefixes/mpc", "archiveName": "libmpc.a" },
    "flint": { "version": "3.6.0", "source": "flint", "prefix": "prefixes/flint", "archiveName": "libflint.a" },
    "arb": { "version": "bundled-with-flint-3.6.0", "source": "flint", "prefix": "prefixes/flint", "archiveName": "libflint.a", "required": false },
    "m4ri": { "version": "20260122", "source": "m4ri", "prefix": "prefixes/m4ri", "archiveName": "libm4ri.a" },
    "ffpoly": { "version": "1.2.7", "source": "ffpoly", "prefix": "prefixes/ffpoly", "archiveName": "libff_poly.a" },
    "smalljac": { "version": "4.1.3", "source": "smalljac", "prefix": "prefixes/smalljac", "archiveName": "libsmalljac.a" }
  },
  "build": {
    "target": "wasm32-wasip1",
    "jobs": 8,
    "cFlags": ["-Oz", "-fPIC", "-fvisibility=hidden"],
    "linkFlags": ["-mexec-model=reactor", "-Wl,--export-memory", "-Wl,--initial-memory=16777216", "-Wl,--max-memory=536870912", "-Wl,--gc-sections"],
    "emulationLibraries": ["wasi-emulated-signal"],
    "repositoryInputs": [
      "packages/wasm-toolchain/scripts/toolchain.cjs",
      "packages/wasm-toolchain/recipes/libraries.cjs",
      "packages/wasm-toolchain/recipes/smalljac.cjs",
      "packages/wasm-toolchain/patches/sagejs_wasi_fenv_compat.h",
      "packages/flint/scripts/portable-smalljac/prepare-sources.cjs",
      "packages/flint/scripts/portable-smalljac/sagejs_ffpoly_word.h",
      "packages/flint/scripts/portable-smalljac/sagejs_gmp_word.h",
      "packages/flint/patches/ffpoly-portability.patch",
      "packages/flint/patches/smalljac-portability.patch"
    ]
  }
}
