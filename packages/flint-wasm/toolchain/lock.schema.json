{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sagejs.org/schemas/wasm-toolchain-lock-v1.json",
  "title": "Sage.js WebAssembly toolchain lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "sourceMirror", "cowasm", "wasiSdk", "libraries", "build"],
  "properties": {
    "$schema": { "type": "string" },
    "schema": { "const": "sagejs.wasm-toolchain-lock/v1" },
    "sourceMirror": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "r2Prefix", "objects"],
      "properties": {
        "schema": { "const": "sagejs.wasm-source-mirror/v1" },
        "r2Prefix": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+[^/]$" },
        "objects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "filename", "sha256"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
              "filename": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]+$" },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "kind": { "enum": ["git-bundle"] },
              "platform": { "type": "string", "pattern": "^(linux|darwin)-(x64|arm64)$" },
              "cowasmTarget": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+$" },
              "archiveEnvironment": { "type": "string", "pattern": "^SAGEJS_[A-Z0-9_]+$" },
              "upstreamUrls": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "format": "uri", "pattern": "^https://" }
              }
            }
          }
        }
      }
    },
    "cowasm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "pnpmLockSha256", "preparedPnpmLockSha256"],
      "properties": {
        "repository": { "type": "string", "format": "uri" },
        "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "pnpmLockSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "preparedPnpmLockSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "wasiSdk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "target", "archives"],
      "properties": {
        "version": { "type": "string" },
        "target": { "const": "wasm32-wasip1" },
        "archives": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "libraries": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "sourceSha256", "prefix"],
        "properties": {
          "version": { "type": "string" },
          "sourceSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "recipeBaseVersion": { "type": "string" },
          "recipeBaseSourceSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "prefix": { "type": "string" },
          "required": { "type": "boolean" },
          "recipe": { "enum": ["sagejs-portable-smalljac"] },
          "url": { "type": "string", "format": "uri" },
          "mirrors": { "type": "array", "items": { "type": "string", "format": "uri" } },
          "archiveEnvironment": { "type": "string", "pattern": "^SAGEJS_[A-Z0-9_]+$" },
          "archiveName": { "type": "string", "pattern": "^lib[A-Za-z0-9_]+\\.a$" }
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wrapperSources", "recipeOverrides", "prepareTargets", "repositoryInputs", "cFlags", "linkFlags"],
      "properties": {
        "wrapperSources": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string" }
        },
        "recipeOverrides": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path"],
            "anyOf": [
              { "required": ["versionFrom", "versionTo"] },
              { "required": ["digestFrom", "digestTo"] },
              { "required": ["urlFrom", "urlTo"] }
            ],
            "properties": {
              "path": { "type": "string" },
              "versionFrom": { "type": "string" },
              "versionTo": { "type": "string" },
              "digestFrom": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "digestTo": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "urlFrom": { "type": "string", "format": "uri", "pattern": "^https://" },
              "urlTo": { "type": "string", "format": "uri", "pattern": "^https://" }
            }
          }
        },
        "prepareTargets": {
          "type": "array",
          "items": { "type": "array", "minItems": 2, "items": { "type": "string" } }
        },
        "repositoryInputs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+$" }
        },
        "cFlags": { "type": "array", "items": { "type": "string" } },
        "linkFlags": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
