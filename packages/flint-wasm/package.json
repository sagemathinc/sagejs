{
  "name": "@sagemath/sagejs-flint-wasm",
  "version": "0.0.1",
  "description": "Browser-compatible FLINT WebAssembly proof of concept for Sage.js",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "bin": {
    "sagejs-wasm": "./node-cli.mjs"
  },
  "exports": {
    ".": "./index.mjs",
    "./algebraic": "./algebraic.mjs",
    "./analytic-backend": "./analytic-backend.mjs",
    "./curve-backend": {
      "types": "./curve-backend.d.ts",
      "import": "./curve-backend.mjs",
      "default": "./curve-backend.mjs"
    },
    "./dirichlet-group": "./dirichlet-group.mjs",
    "./evaluator": "./evaluator.mjs",
    "./m4ri": "./m4ri.mjs",
    "./multivariate-backend": "./multivariate-backend.mjs",
    "./lazy-modules": "./lazy-modules.mjs",
    "./number-field-zeta": "./number-field-zeta.mjs",
    "./kernel": {
      "types": "./kernel.d.ts",
      "import": "./kernel.mjs",
      "default": "./kernel.mjs"
    },
    "./node": {
      "types": "./kernel.d.ts",
      "import": "./node-kernel.mjs",
      "default": "./node-kernel.mjs"
    },
    "./plotly-renderer": {
      "types": "./plotly-renderer.d.ts",
      "import": "./plotly-renderer.mjs",
      "default": "./plotly-renderer.mjs"
    }
  },
  "files": [
    "dist/flint-factor.wasm",
    "dist/flint-algebraic.wasm",
    "dist/native-kernels/",
    "dist/wasm-pack-loader.mjs",
    "dist/ffi-production-closure.json",
    "dist/lazy-modules.json",
    "dist/dynamic-programs.json",
    "dist/production-kernel-coverage.json",
    "dist/production-manifest.json",
    "dist/build-receipt.json",
    "dist/runtime/",
    "dist/ffi-resource-adapter.c",
    "dist/ffi-resource-backend.mjs",
    "dist/ffi-resource-manifest.json",
    "dist/m4ri-resource.wasm",
    "dist/m4ri-resource-adapter.c",
    "dist/m4ri-resource-backend.mjs",
    "dist/m4ri-resource-manifest.json",
    "dist/numpy-ts.mjs",
    "dist/compiler.js",
    "dist/compiler-frontend.mjs",
    "dist/foreign-frontend.mjs",
    "dist/web-tree-sitter.wasm",
    "dist/tree-sitter-python.wasm",
    "dist/tree-sitter-sage.wasm",
    "dist/tree-sitter-magma.wasm",
    "dist/tree-sitter-macaulay2.wasm",
    "dist/tree-sitter-maple.wasm",
    "dist/tree-sitter-matlab.wasm",
    "dist/tree-sitter-wolfram.wasm",
    "dist/baselib.js",
    "dist/plotly.min.js",
    "dist/stdlib.json",
    "dist/symbolic-backend.mjs",
    "dist/serialization.mjs",
    "dist/wasi-runtime.mjs",
    "release/",
    "algebraic.mjs",
    "analytic-backend.mjs",
    "compiler-worker.mjs",
    "dynamic-compiler.mjs",
    "curve-backend.d.ts",
    "curve-backend.mjs",
    "dirichlet-group.mjs",
    "evaluator.mjs",
    "index.mjs",
    "m4ri.mjs",
    "multivariate-backend.mjs",
    "lazy-modules.mjs",
    "number-field-zeta.mjs",
    "kernel.d.ts",
    "kernel-worker.mjs",
    "kernel.mjs",
    "node-cli.mjs",
    "node-kernel.mjs",
    "node-worker.mjs",
    "node-worker-bootstrap.mjs",
    "plotly-renderer.d.ts",
    "plotly-renderer.mjs",
    "portable-matrix.mjs",
    "portable-polynomial.mjs",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.cjs",
    "test": "pnpm run build && node --expose-gc --test test/*.test.mjs test/*.test.cjs",
    "test:browser": "pnpm run build && node test/browser-smoke.mjs",
    "test:browser:webkit-file-origin": "node test/browser-wasm-webkit-file-origin.mjs",
    "test:browser:webkit-memory": "node test/browser-wasm-webkit-memory.mjs",
    "test:browser-dynamic-code": "pnpm run build && node test/browser-dynamic-code.mjs",
    "test:resource-browser": "pnpm run build && node test/resource-browser-smoke.mjs"
  },
  "dependencies": {
    "path-browserify": "1.0.1"
  },
  "devDependencies": {
    "plotly.js-dist-min": "3.7.0"
  }
}
