{
  "name": "@sagemath/sagejs-flint-wasm",
  "version": "0.0.1",
  "description": "Browser-compatible FLINT WebAssembly proof of concept for Sage.js",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.mjs",
    "./evaluator": "./evaluator.mjs",
    "./kernel": {
      "types": "./kernel.d.ts",
      "import": "./kernel.mjs",
      "default": "./kernel.mjs"
    }
  },
  "files": [
    "dist/flint-factor.wasm",
    "dist/compiler.js",
    "dist/baselib.js",
    "dist/wasi-runtime.mjs",
    "compiler-worker.mjs",
    "evaluator.mjs",
    "index.mjs",
    "kernel.d.ts",
    "kernel-worker.mjs",
    "kernel.mjs",
    "portable-polynomial.mjs",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.cjs",
    "test": "pnpm run build && node --test test/factor.test.mjs",
    "test:browser": "pnpm run build && node test/browser-smoke.mjs"
  },
  "dependencies": {
    "@cowasm/memfs": "3.5.1",
    "assert": "2.1.0",
    "buffer": "6.0.3",
    "events": "3.3.0",
    "path-browserify": "1.0.1",
    "process": "0.11.10",
    "stream-browserify": "3.0.0",
    "util": "0.12.5",
    "wasi-js": "1.7.3"
  }
}
