{
  "schema": "sagejs.wasm-production-layout/v1",
  "modules": [
    {
      "id": "flint",
      "ownershipDomain": "flint-gmp-mpfr-mpc-arb",
      "artifact": "flint-factor.wasm",
      "eager": true,
      "memory": {
        "pageBytes": 65536,
        "initialPages": 256,
        "maximumPages": 8192
      }
    },
    {
      "id": "m4ri",
      "ownershipDomain": "m4ri",
      "artifact": "m4ri-resource.wasm",
      "eager": false,
      "memory": {
        "pageBytes": 65536,
        "initialPages": 256,
        "maximumPages": 8192
      }
    }
  ],
  "hostAssets": [
    "compiler.js",
    "compiler-frontend.mjs",
    "baselib.js",
    "stdlib.json",
    "symbolic-backend.mjs",
    "serialization.mjs",
    "wasi-runtime.mjs",
    "web-tree-sitter.wasm",
    "tree-sitter-python.wasm",
    "tree-sitter-sage.wasm"
  ],
  "runtimeHostAssets": {
    "source": ".",
    "includeExtensions": [".mjs", ".d.ts"],
    "destination": "runtime",
    "serveDestination": "."
  },
  "distServeDestination": "dist",
  "generatedInputs": "../toolchain/adapter-inputs.json",
  "rules": {
    "resourcePointersCrossModules": false,
    "crossModuleTransfer": "canonical-copied-bytes",
    "publicObjectsMaterializedByHost": true
  }
}
