{
  "schema": "sagejs.wasm-production-layout/v1",
  "modules": [
    {
      "id": "flint",
      "ownershipDomain": "flint-gmp-mpfr-mpc-arb",
      "artifact": "flint-factor.wasm",
      "eager": true,
      "memory": {
        "pageBytes": 65536,
        "initialPages": 256,
        "maximumPages": 8192
      }
    },
    {
      "id": "m4ri",
      "ownershipDomain": "m4ri",
      "artifact": "m4ri-resource.wasm",
      "eager": false,
      "memory": {
        "pageBytes": 65536,
        "initialPages": 256,
        "maximumPages": 8192
      }
    },
    {
      "id": "algebraic",
      "ownershipDomain": "flint-gmp-mpfr-arb-algebraic",
      "artifact": "flint-algebraic.wasm",
      "eager": false,
      "memory": {
        "pageBytes": 65536,
        "initialPages": 256,
        "maximumPages": 8192
      }
    },
    {
      "id": "kernel-flint",
      "ownershipDomain": "source-kernel-flint",
      "artifact": "native-kernels/kernel-flint.wasm",
      "eager": false,
      "memory": {
        "pageBytes": 65536,
        "initialPages": 256,
        "maximumPages": 8192
      }
    },
    {
      "id": "kernel-gmp",
      "ownershipDomain": "source-kernel-gmp",
      "artifact": "native-kernels/kernel-gmp.wasm",
      "eager": false,
      "memory": {
        "pageBytes": 65536,
        "initialPages": 256,
        "maximumPages": 8192
      }
    }
  ],
  "importedMemoryDomains": [
    {
      "id": "tree-sitter",
      "provider": "web-tree-sitter.wasm",
      "consumers": [
        "tree-sitter-python.wasm",
        "tree-sitter-sage.wasm"
      ],
      "memory": {
        "pageBytes": 65536,
        "initialPages": 512,
        "maximumPages": 6144
      }
    }
  ],
  "hostAssets": [
    "compiler.js",
    "compiler-frontend.mjs",
    "baselib.js",
    "stdlib.json",
    "lazy-modules.json",
    "dynamic-programs.json",
    "symbolic-backend.mjs",
    "serialization.mjs",
    "wasi-runtime.mjs",
    "ffi-production-closure.json",
    "native-kernels/index.json",
    "wasm-pack-loader.mjs",
    "web-tree-sitter.wasm",
    "tree-sitter-python.wasm",
    "tree-sitter-sage.wasm"
    ,
    "wasm-capability-api.mjs",
    "wasm-capabilities-report.json"
  ],
  "runtimeHostAssets": {
    "source": ".",
    "includeExtensions": [".mjs", ".d.ts"],
    "destination": "runtime",
    "serveDestination": "."
  },
  "distServeDestination": "dist",
  "generatedInputs": "../toolchain/adapter-inputs.json",
  "rules": {
    "resourcePointersCrossModules": false,
    "crossModuleTransfer": "canonical-copied-bytes",
    "publicObjectsMaterializedByHost": true
  }
}
