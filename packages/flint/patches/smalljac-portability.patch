@@ -64,6 +69,10 @@ static inline unsigned long cstd_seed(void)
 {
 	if ( ! _cstd_seed ) {
+#if defined(_WIN32)
+		_cstd_seed = ((uint64_t)_getpid() << 32) ^ (uint64_t)time(0);
