 static inline unsigned long ui_ceil_ratio (unsigned long a, unsigned long b)
 	{ register unsigned long x = a/b;  return ( x*b<a ? x+1 : x ); }
 static inline int ui_len (unsigned long x) { return LONG_BITS-__builtin_clzl(x); }
