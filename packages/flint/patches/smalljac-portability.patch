+#if defined(__wasm__)
+/* GMP's scanf implementation calls through permissively cast callbacks that
+   are valid on conventional ABIs but trap on Wasm's typed function table.
+   Weierstrass input has a fixed grammar, so parse its five integers directly. */
+static int sagejs_smalljac_parse_ws(char *input, mpz_ptr output[5])
+{
+	char *cursor = input;
+	int index;
+	if ( *cursor++ != '[' ) return 0;
+	for ( index = 0 ; index < 5 ; index++ ) {
+		char *begin, saved;
+		while ( isspace(*cursor) ) cursor++;
+		begin = cursor;
+		if ( *cursor == '-' || *cursor == '+' ) cursor++;
+		while ( *cursor >= '0' && *cursor <= '9' ) cursor++;
+		if ( cursor == begin ||
+			((begin[0] == '-' || begin[0] == '+') && cursor == begin + 1) )
+			return 0;
+		saved = *cursor;
+		*cursor = '\0';
+		if ( mpz_set_str(output[index], begin, 10) != 0 ) {
+			*cursor = saved;
+			return 0;
+		}
+		*cursor = saved;
+		while ( isspace(*cursor) ) cursor++;
+		if ( index < 4 ) {
+			if ( *cursor++ != ',' ) return 0;
+		} else if ( *cursor++ != ']' ) {
+			return 0;
+		}
+	}
+	while ( isspace(*cursor) ) cursor++;
+	return *cursor == '\0';
+}
+#endif
