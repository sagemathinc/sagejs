+
+ZZX from_flint(const fmpz_poly_t input)
+{
+  ZZX output;
+  for (slong index = 0; index < fmpz_poly_length(input); ++index)
+    {
+      ZZ coefficient;
+      fmpz_poly_get_coeff_fmpz(coefficient.data(), input, index);
+      SetCoeff(output, index, coefficient);
+    }
+  return output;
+}
+
+void to_flint(fmpz_mod_poly_t output, const ZZ_pX& input,
+              const fmpz_mod_ctx_t context)
+{
+  fmpz_mod_poly_init(output, context);
+  for (long index = 0; index <= deg(input); ++index)
+    fmpz_mod_poly_set_coeff_fmpz(output, index, rep(coeff(input, index)).data(), context);
+}
+
+ZZ_pX from_flint(const fmpz_mod_poly_t input, const fmpz_mod_ctx_t context)
+{
+  ZZ_pX output;
+  for (slong index = 0; index < fmpz_mod_poly_length(input, context); ++index)
+    {
+      ZZ coefficient;
+      fmpz_mod_poly_get_coeff_fmpz(coefficient.data(), input, index, context);
+      SetCoeff(output, index, to_ZZ_p(coefficient));
+    }
+  return output;
+}
+
+void factor(ZZ& content, vec_pair_ZZX_long& factors, const ZZX& input)
+{
+  fmpz_poly_t polynomial;
+  to_flint(polynomial, input);
+  fmpz_poly_factor_t factorization;
+  fmpz_poly_factor_init(factorization);
+  fmpz_poly_factor(factorization, polynomial);
+  fmpz_set(content.data(), &factorization->c);
+  factors.clear();
+  factors.reserve(static_cast<size_t>(factorization->num));
+  for (slong index = 0; index < factorization->num; ++index)
+    factors.push_back({from_flint(factorization->p + index), factorization->exp[index]});
+  fmpz_poly_factor_clear(factorization);
+  fmpz_poly_clear(polynomial);
+}
+
+vec_pair_ZZ_pX_long factor_mod(const ZZ_pX& input)
+{
+  fmpz_mod_ctx_t context;
+  fmpz_mod_ctx_init(context, flint_modulus.data());
+  fmpz_mod_poly_t polynomial;
+  to_flint(polynomial, input, context);
+  fmpz_mod_poly_factor_t factorization;
+  fmpz_mod_poly_factor_init(factorization, context);
+  fmpz_mod_poly_factor(factorization, polynomial, context);
+  vec_pair_ZZ_pX_long factors;
+  factors.reserve(static_cast<size_t>(factorization->num));
+  for (slong index = 0; index < factorization->num; ++index)
+    factors.push_back({from_flint(factorization->poly + index, context),
+                       factorization->exp[index]});
+  fmpz_mod_poly_factor_clear(factorization, context);
+  fmpz_mod_poly_clear(polynomial, context);
+  fmpz_mod_ctx_clear(context);
+  return factors;
+}
