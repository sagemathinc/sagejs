+// FLINT-only compatibility types for eclib's historical arithmetic surface.
+#ifndef ECLIB_FLINT_BACKEND_H
+#define ECLIB_FLINT_BACKEND_H
+
+#include <flint/fmpz.h>
+#include <flint/fmpz_factor.h>
+#include <flint/fmpz_mod.h>
+#include <flint/fmpz_mod_poly.h>
+#include <flint/fmpz_mod_poly_factor.h>
+#include <flint/fmpz_poly.h>
+#include <flint/fmpz_poly_factor.h>
+#include <flint/flint.h>
+
+#include <cmath>
+#include <cassert>
+#include <cstddef>
+#include <iostream>
+#include <stdexcept>
+#include <string>
+#include <type_traits>
+#include <utility>
+#include <vector>
+
+class ZZ {
+public:
+  ZZ() { fmpz_init(value_); }
+  ZZ(int value) { fmpz_init_set_si(value_, value); }
+  ZZ(long value) { fmpz_init_set_si(value_, value); }
+  explicit ZZ(const std::string& value) {
+    fmpz_init(value_);
+    fmpz_set_str(value_, value.c_str(), 10);
+  }
+  ZZ(const ZZ& other) { fmpz_init_set(value_, other.value_); }
+  ZZ(ZZ&& other) noexcept {
+    fmpz_init(value_);
+    fmpz_swap(value_, other.value_);
+  }
+  ~ZZ() { fmpz_clear(value_); }
+
+  ZZ& operator=(const ZZ& other) {
+    if (this != &other) fmpz_set(value_, other.value_);
+    return *this;
+  }
+  ZZ& operator=(ZZ&& other) noexcept {
+    if (this != &other) fmpz_swap(value_, other.value_);
+    return *this;
+  }
+  ZZ& operator=(long value) { fmpz_set_si(value_, value); return *this; }
+  ZZ& operator=(int value) { fmpz_set_si(value_, value); return *this; }
+
+  static ZZ zero() { return ZZ(0); }
+  const fmpz* data() const { return value_; }
+  fmpz* data() { return value_; }
+
+  ZZ operator+() const { return *this; }
+  ZZ operator-() const { ZZ out; fmpz_neg(out.value_, value_); return out; }
+  ZZ operator+(const ZZ& other) const { ZZ out; fmpz_add(out.value_, value_, other.value_); return out; }
+  ZZ operator-(const ZZ& other) const { ZZ out; fmpz_sub(out.value_, value_, other.value_); return out; }
+  ZZ operator*(const ZZ& other) const { ZZ out; fmpz_mul(out.value_, value_, other.value_); return out; }
+  ZZ operator/(const ZZ& other) const { ZZ out; fmpz_tdiv_q(out.value_, value_, other.value_); return out; }
+  ZZ operator%(const ZZ& other) const {
+    ZZ quotient, out;
+    fmpz_tdiv_qr(quotient.value_, out.value_, value_, other.value_);
+    return out;
+  }
+  ZZ operator+(long other) const { ZZ out; fmpz_add_si(out.value_, value_, other); return out; }
+  ZZ operator-(long other) const { ZZ out; fmpz_sub_si(out.value_, value_, other); return out; }
+  ZZ operator*(long other) const { ZZ out; fmpz_mul_si(out.value_, value_, other); return out; }
+  ZZ operator/(long other) const { ZZ out; fmpz_tdiv_q_si(out.value_, value_, other); return out; }
+  long operator%(long other) const {
+    const ulong modulus = static_cast<ulong>(other < 0 ? -other : other);
+    const long remainder = static_cast<long>(fmpz_tdiv_ui(value_, modulus));
+    return fmpz_sgn(value_) < 0 ? -remainder : remainder;
+  }
+  ZZ operator<<(long count) const { ZZ out; fmpz_mul_2exp(out.value_, value_, count); return out; }
+  ZZ operator>>(long count) const { ZZ out; fmpz_fdiv_q_2exp(out.value_, value_, count); return out; }
+
+  ZZ& operator+=(const ZZ& other) { fmpz_add(value_, value_, other.value_); return *this; }
+  ZZ& operator-=(const ZZ& other) { fmpz_sub(value_, value_, other.value_); return *this; }
+  ZZ& operator*=(const ZZ& other) { fmpz_mul(value_, value_, other.value_); return *this; }
+  ZZ& operator/=(const ZZ& other) { fmpz_tdiv_q(value_, value_, other.value_); return *this; }
+  ZZ& operator%=(const ZZ& other) {
+    ZZ quotient, remainder;
+    fmpz_tdiv_qr(quotient.value_, remainder.value_, value_, other.value_);
+    fmpz_set(value_, remainder.value_);
+    return *this;
+  }
+  ZZ& operator+=(long other) { fmpz_add_si(value_, value_, other); return *this; }
+  ZZ& operator-=(long other) { fmpz_sub_si(value_, value_, other); return *this; }
+  ZZ& operator*=(long other) { fmpz_mul_si(value_, value_, other); return *this; }
+  ZZ& operator/=(long other) { fmpz_tdiv_q_si(value_, value_, other); return *this; }
+  ZZ& operator<<=(long count) { fmpz_mul_2exp(value_, value_, count); return *this; }
+  ZZ& operator>>=(long count) { fmpz_fdiv_q_2exp(value_, value_, count); return *this; }
+  ZZ& operator++() { fmpz_add_ui(value_, value_, 1); return *this; }
+  ZZ operator++(int) { ZZ old(*this); ++*this; return old; }
+  ZZ& operator--() { fmpz_sub_ui(value_, value_, 1); return *this; }
+  ZZ operator--(int) { ZZ old(*this); --*this; return old; }
+
+  friend bool operator==(const ZZ& left, const ZZ& right) { return fmpz_equal(left.value_, right.value_); }
+  friend bool operator!=(const ZZ& left, const ZZ& right) { return !fmpz_equal(left.value_, right.value_); }
+  friend bool operator<(const ZZ& left, const ZZ& right) { return fmpz_cmp(left.value_, right.value_) < 0; }
+  friend bool operator<=(const ZZ& left, const ZZ& right) { return fmpz_cmp(left.value_, right.value_) <= 0; }
+  friend bool operator>(const ZZ& left, const ZZ& right) { return fmpz_cmp(left.value_, right.value_) > 0; }
+  friend bool operator>=(const ZZ& left, const ZZ& right) { return fmpz_cmp(left.value_, right.value_) >= 0; }
+  friend bool operator==(const ZZ& left, long right) { return fmpz_equal_si(left.value_, right); }
+  friend bool operator!=(const ZZ& left, long right) { return !fmpz_equal_si(left.value_, right); }
+  friend bool operator<(const ZZ& left, long right) { return fmpz_cmp_si(left.value_, right) < 0; }
+  friend bool operator<=(const ZZ& left, long right) { return fmpz_cmp_si(left.value_, right) <= 0; }
+  friend bool operator>(const ZZ& left, long right) { return fmpz_cmp_si(left.value_, right) > 0; }
+  friend bool operator>=(const ZZ& left, long right) { return fmpz_cmp_si(left.value_, right) >= 0; }
+
+  friend std::ostream& operator<<(std::ostream& stream, const ZZ& value) {
+    char* text = fmpz_get_str(nullptr, 10, value.value_);
+    stream << text;
+    flint_free(text);
+    return stream;
+  }
+  friend std::istream& operator>>(std::istream& stream, ZZ& value) {
+    std::string text;
+    stream >> text;
+    if (stream && fmpz_set_str(value.value_, text.c_str(), 10) != 0) {
+      stream.setstate(std::ios::failbit);
+    }
+    return stream;
+  }
+
+private:
+  fmpz_t value_;
+};
+
+inline ZZ operator+(long left, const ZZ& right) { return right + left; }
+inline ZZ operator-(long left, const ZZ& right) { return ZZ(left) - right; }
+inline ZZ operator*(long left, const ZZ& right) { return right * left; }
+inline ZZ operator/(long left, const ZZ& right) { return ZZ(left) / right; }
+inline bool operator==(long left, const ZZ& right) { return right == left; }
+inline bool operator!=(long left, const ZZ& right) { return right != left; }
+inline bool operator<(long left, const ZZ& right) { return right > left; }
+inline bool operator<=(long left, const ZZ& right) { return right >= left; }
+inline bool operator>(long left, const ZZ& right) { return right < left; }
+inline bool operator>=(long left, const ZZ& right) { return right <= left; }
+
+inline ZZ to_ZZ(long value) { return ZZ(value); }
+inline ZZ to_ZZ(int value) { return ZZ(value); }
+inline ZZ to_ZZ(const ZZ& value) { return value; }
+inline ZZ to_ZZ(const char* value) { return ZZ(std::string(value)); }
+inline ZZ to_ZZ(const INT& value) {
+  fmpz_t temporary;
+  value.get_fmpz(temporary);
+  ZZ out;
+  fmpz_set(out.data(), temporary);
+  fmpz_clear(temporary);
+  return out;
+}
+inline long to_long(const ZZ& value) {
+  assert(fmpz_fits_si(value.data()));
+  return fmpz_get_si(value.data());
+}
+inline int to_int(const ZZ& value) { return static_cast<int>(to_long(value)); }
+inline INT to_INT(int value) { return INT(value); }
+inline INT to_INT(long value) { return INT(value); }
+inline INT to_INT(const INT& value) { return value; }
+inline INT to_INT(const ZZ& value) {
+  fmpz_t temporary;
+  fmpz_init_set(temporary, value.data());
+  INT out(temporary);
+  fmpz_clear(temporary);
+  return out;
+}
+inline double to_double(const ZZ& value) { return fmpz_get_d(value.data()); }
+inline long rem(const ZZ& value, long modulus) { return value % modulus; }
+inline int sign(const ZZ& value) { return fmpz_sgn(value.data()); }
+inline bool IsZero(const ZZ& value) { return fmpz_is_zero(value.data()); }
+inline bool IsOne(const ZZ& value) { return fmpz_is_one(value.data()); }
+inline bool IsOdd(const ZZ& value) { return fmpz_is_odd(value.data()); }
+inline long bit(const ZZ& value, long index) { return fmpz_tstbit(value.data(), index); }
+inline long bit(long value, long index) { return (value >> index) & 1L; }
+inline long NumBits(const ZZ& value) { return fmpz_bits(value.data()); }
+inline void SetBit(ZZ& value, long index) { fmpz_setbit(value.data(), index); }
+inline void LeftShift(ZZ& out, const ZZ& value, long count) { fmpz_mul_2exp(out.data(), value.data(), count); }
+inline void RightShift(ZZ& out, const ZZ& value, long count) { fmpz_fdiv_q_2exp(out.data(), value.data(), count); }
+inline void add(ZZ& out, const ZZ& left, const ZZ& right) { fmpz_add(out.data(), left.data(), right.data()); }
+inline void sub(ZZ& out, const ZZ& left, const ZZ& right) { fmpz_sub(out.data(), left.data(), right.data()); }
+inline void mul(ZZ& out, const ZZ& left, const ZZ& right) { fmpz_mul(out.data(), left.data(), right.data()); }
+inline void div(ZZ& out, const ZZ& left, const ZZ& right) { fmpz_tdiv_q(out.data(), left.data(), right.data()); }
+inline void negate(ZZ& out, const ZZ& value) { fmpz_neg(out.data(), value.data()); }
+inline void sqr(ZZ& out, const ZZ& value) { fmpz_mul(out.data(), value.data(), value.data()); }
+inline ZZ sqr(const ZZ& value) { ZZ out; sqr(out, value); return out; }
+inline ZZ abs(const ZZ& value) { ZZ out; fmpz_abs(out.data(), value.data()); return out; }
+inline void SqrRoot(ZZ& out, const ZZ& value) { fmpz_sqrt(out.data(), value.data()); }
+inline ZZ SqrRoot(const ZZ& value) { ZZ out; SqrRoot(out, value); return out; }
+inline ZZ GCD(const ZZ& left, const ZZ& right) { ZZ out; fmpz_gcd(out.data(), left.data(), right.data()); return out; }
+inline void XGCD(ZZ& gcd, ZZ& left_cofactor, ZZ& right_cofactor, const ZZ& left, const ZZ& right) {
+  fmpz_xgcd(gcd.data(), left_cofactor.data(), right_cofactor.data(), left.data(), right.data());
+}
+inline ZZ power(const ZZ& value, long exponent) { ZZ out; fmpz_pow_ui(out.data(), value.data(), exponent); return out; }
+inline long Jacobi(const ZZ& value, const ZZ& modulus) { return fmpz_jacobi(value.data(), modulus.data()); }
+inline void SqrRootMod(ZZ& out, const ZZ& value, const ZZ& modulus) {
+  fmpz_sqrtmod(out.data(), value.data(), modulus.data());
+}
+inline void PowerMod(ZZ& out, const ZZ& base, const ZZ& exponent, const ZZ& modulus) {
+  fmpz_powm(out.data(), base.data(), exponent.data(), modulus.data());
+}
+inline void DivRem(ZZ& quotient, ZZ& remainder, const ZZ& numerator, const ZZ& denominator) {
+  fmpz_tdiv_qr(quotient.data(), remainder.data(), numerator.data(), denominator.data());
+}
+inline long DivRem(ZZ& quotient, const ZZ& numerator, long denominator) {
+  ZZ remainder;
+  fmpz_tdiv_qr(quotient.data(), remainder.data(), numerator.data(), ZZ(denominator).data());
+  return fmpz_get_si(remainder.data());
+}
+inline void swap(ZZ& left, ZZ& right) { fmpz_swap(left.data(), right.data()); }
+inline ZZ NextPrime(const ZZ& value) { ZZ out; fmpz_nextprime(out.data(), value.data(), 1); return out; }
+inline bool ProbPrime(const ZZ& value) { return fmpz_is_prime(value.data()); }
+
+template <class Coefficient>
+class FlintPolynomial {
+public:
+  std::vector<Coefficient> rep;
+
+  FlintPolynomial() = default;
+  FlintPolynomial(long degree, const Coefficient& coefficient) {
+    if (degree >= 0) {
+      rep.resize(static_cast<std::size_t>(degree + 1));
+      rep[static_cast<std::size_t>(degree)] = coefficient;
+      normalize();
+    }
+  }
+  FlintPolynomial(long constant) {
+    Coefficient value(constant);
+    if (!IsZero(value)) rep.push_back(value);
+  }
+  FlintPolynomial(const Coefficient& constant) {
+    if (!IsZero(constant)) rep.push_back(constant);
+  }
+  void SetLength(long length) { rep.resize(static_cast<std::size_t>(length)); }
+  void normalize() {
+    while (!rep.empty() && IsZero(rep.back())) rep.pop_back();
+  }
+  FlintPolynomial operator+() const { return *this; }
+  FlintPolynomial operator-() const {
+    FlintPolynomial out(*this);
+    for (auto& coefficient : out.rep) coefficient = -coefficient;
+    return out;
+  }
+  FlintPolynomial operator+(const FlintPolynomial& other) const {
+    FlintPolynomial out;
+    out.rep.resize(std::max(rep.size(), other.rep.size()));
+    for (std::size_t index = 0; index < out.rep.size(); ++index) {
+      const Coefficient left = index < rep.size() ? rep[index] : Coefficient(0);
+      const Coefficient right = index < other.rep.size() ? other.rep[index] : Coefficient(0);
+      out.rep[index] = left + right;
+    }
+    out.normalize();
+    return out;
+  }
+  FlintPolynomial operator-(const FlintPolynomial& other) const { return *this + (-other); }
+  FlintPolynomial operator*(const FlintPolynomial& other) const {
+    FlintPolynomial out;
+    if (rep.empty() || other.rep.empty()) return out;
+    out.rep.resize(rep.size() + other.rep.size() - 1);
+    for (std::size_t left = 0; left < rep.size(); ++left)
+      for (std::size_t right = 0; right < other.rep.size(); ++right)
+        out.rep[left + right] += rep[left] * other.rep[right];
+    out.normalize();
+    return out;
+  }
+  FlintPolynomial operator+(const Coefficient& scalar) const {
+    FlintPolynomial out(*this);
+    if (out.rep.empty()) out.rep.push_back(scalar); else out.rep[0] += scalar;
+    out.normalize();
+    return out;
+  }
+  FlintPolynomial operator-(const Coefficient& scalar) const { return *this + (-scalar); }
+  FlintPolynomial operator*(const Coefficient& scalar) const {
+    FlintPolynomial out(*this);
+    for (auto& coefficient : out.rep) coefficient *= scalar;
+    out.normalize();
+    return out;
+  }
+  FlintPolynomial& operator+=(const FlintPolynomial& other) { *this = *this + other; return *this; }
+  FlintPolynomial& operator-=(const FlintPolynomial& other) { *this = *this - other; return *this; }
+  FlintPolynomial& operator*=(const FlintPolynomial& other) { *this = *this * other; return *this; }
+  FlintPolynomial& operator*=(const Coefficient& scalar) { *this = *this * scalar; return *this; }
+  FlintPolynomial& operator/=(const FlintPolynomial& divisor) { *this = divide_exact(divisor); return *this; }
+  FlintPolynomial operator/(const FlintPolynomial& divisor) const { return divide_exact(divisor); }
+  friend bool operator==(const FlintPolynomial& left, const FlintPolynomial& right) {
+    return left.rep == right.rep;
+  }
+  friend bool operator!=(const FlintPolynomial& left, const FlintPolynomial& right) {
+    return !(left == right);
+  }
+  friend FlintPolynomial operator+(const Coefficient& scalar, const FlintPolynomial& polynomial) {
+    return polynomial + scalar;
+  }
+  friend FlintPolynomial operator-(const Coefficient& scalar, const FlintPolynomial& polynomial) {
+    return (-polynomial) + scalar;
+  }
+  friend FlintPolynomial operator*(const Coefficient& scalar, const FlintPolynomial& polynomial) {
+    return polynomial * scalar;
+  }
+private:
+  FlintPolynomial divide_exact(const FlintPolynomial& divisor) const {
+    if (divisor.rep.empty()) throw std::domain_error("polynomial division by zero");
+    FlintPolynomial remainder(*this), quotient;
+    const long divisor_degree = static_cast<long>(divisor.rep.size()) - 1;
+    if (static_cast<long>(remainder.rep.size()) - 1 < divisor_degree) return quotient;
+    quotient.rep.resize(remainder.rep.size() - divisor.rep.size() + 1);
+    while (!remainder.rep.empty() &&
+           static_cast<long>(remainder.rep.size()) - 1 >= divisor_degree) {
+      const long shift = static_cast<long>(remainder.rep.size()) - 1 - divisor_degree;
+      const Coefficient factor = remainder.rep.back() / divisor.rep.back();
+      quotient.rep[static_cast<std::size_t>(shift)] += factor;
+      for (long index = 0; index <= divisor_degree; ++index)
+        remainder.rep[static_cast<std::size_t>(index + shift)] -=
+          factor * divisor.rep[static_cast<std::size_t>(index)];
+      remainder.normalize();
+    }
+    if (!remainder.rep.empty()) throw std::domain_error("inexact polynomial division");
+    quotient.normalize();
+    return quotient;
+  }
+};
+
+using ZZX = FlintPolynomial<ZZ>;
+
+inline thread_local ZZ flint_modulus(0);
+
+class FlintRandomState {
+public:
+  FlintRandomState() { flint_rand_init(state_); reset(); }
+  ~FlintRandomState() { flint_rand_clear(state_); }
+  void reset() { flint_rand_set_seed(state_, 0x53414745UL, 0x4a535241UL); }
+  flint_rand_struct* data() { return state_; }
+private:
+  flint_rand_t state_;
+};
+
+inline thread_local FlintRandomState flint_random_state;
+inline void reset_flint_random_state() { flint_random_state.reset(); }
+
+inline ZZ flint_mod_reduce(const ZZ& value) {
+  if (IsZero(flint_modulus)) return value;
+  ZZ out;
+  fmpz_mod(out.data(), value.data(), flint_modulus.data());
+  return out;
+}
+
+class ZZ_p {
+public:
+  ZZ_p() = default;
+  ZZ_p(long value) : value_(flint_mod_reduce(ZZ(value))) {}
+  ZZ_p(const ZZ& value) : value_(flint_mod_reduce(value)) {}
+  static void init(const ZZ& modulus) { flint_modulus = abs(modulus); }
+  const ZZ& value() const { return value_; }
+  ZZ_p operator+() const { return *this; }
+  ZZ_p operator-() const { return ZZ_p(-value_); }
+  ZZ_p operator+(const ZZ_p& other) const { return ZZ_p(value_ + other.value_); }
+  ZZ_p operator-(const ZZ_p& other) const { return ZZ_p(value_ - other.value_); }
+  ZZ_p operator*(const ZZ_p& other) const { return ZZ_p(value_ * other.value_); }
+  ZZ_p operator/(const ZZ_p& other) const {
+    ZZ inverse;
+    if (!fmpz_invmod(inverse.data(), other.value_.data(), flint_modulus.data())) {
+      throw std::domain_error("division by a nonunit in ZZ_p");
+    }
+    return ZZ_p(value_ * inverse);
+  }
+  ZZ_p& operator+=(const ZZ_p& other) { *this = *this + other; return *this; }
+  ZZ_p& operator-=(const ZZ_p& other) { *this = *this - other; return *this; }
+  ZZ_p& operator*=(const ZZ_p& other) { *this = *this * other; return *this; }
+  ZZ_p& operator/=(const ZZ_p& other) { *this = *this / other; return *this; }
+  friend bool operator==(const ZZ_p& left, const ZZ_p& right) { return left.value_ == right.value_; }
+  friend bool operator!=(const ZZ_p& left, const ZZ_p& right) { return left.value_ != right.value_; }
+  friend std::ostream& operator<<(std::ostream& stream, const ZZ_p& value) {
+    return stream << value.value_;
+  }
+private:
+  ZZ value_;
+};
+
+inline ZZ_p operator+(long left, const ZZ_p& right) { return ZZ_p(left) + right; }
+inline ZZ_p operator-(long left, const ZZ_p& right) { return ZZ_p(left) - right; }
+inline ZZ_p operator*(long left, const ZZ_p& right) { return ZZ_p(left) * right; }
+inline ZZ_p operator/(long left, const ZZ_p& right) { return ZZ_p(left) / right; }
+inline ZZ_p operator+(const ZZ_p& left, long right) { return left + ZZ_p(right); }
+inline ZZ_p operator-(const ZZ_p& left, long right) { return left - ZZ_p(right); }
+inline ZZ_p operator*(const ZZ_p& left, long right) { return left * ZZ_p(right); }
+inline ZZ_p operator/(const ZZ_p& left, long right) { return left / ZZ_p(right); }
+
+inline ZZ rep(const ZZ_p& value) { return value.value(); }
+inline ZZ_p to_ZZ_p(const ZZ& value) { return ZZ_p(value); }
+inline ZZ_p to_ZZ_p(long value) { return ZZ_p(value); }
+inline bool IsZero(const ZZ_p& value) { return IsZero(rep(value)); }
+inline bool IsOne(const ZZ_p& value) { return IsOne(rep(value)); }
+inline ZZ_p inv(const ZZ_p& value) { return ZZ_p(1) / value; }
+inline void inv(ZZ_p& out, const ZZ_p& value) { out = inv(value); }
+inline void power(ZZ_p& out, const ZZ_p& value, const ZZ& exponent) {
+  ZZ powered;
+  fmpz_powm(powered.data(), rep(value).data(), exponent.data(), flint_modulus.data());
+  out = ZZ_p(powered);
+}
+inline ZZ_p power(const ZZ_p& value, long exponent) {
+  ZZ powered;
+  fmpz_powm_ui(powered.data(), rep(value).data(), exponent, flint_modulus.data());
+  return ZZ_p(powered);
+}
+inline ZZ_p random_ZZ_p() {
+  ZZ value;
+  if (!IsZero(flint_modulus))
+    fmpz_randm(value.data(), flint_random_state.data(), flint_modulus.data());
+  return ZZ_p(value);
+}
+inline void random(ZZ_p& value) { value = random_ZZ_p(); }
+
+using zz_p = ZZ_p;
+template <class T>
+class FlintVector : public std::vector<T> {
+public:
+  using std::vector<T>::vector;
+  long length() const { return static_cast<long>(this->size()); }
+  void SetLength(long length) { this->resize(static_cast<std::size_t>(length)); }
+};
+
+using vec_ZZ_p = FlintVector<ZZ_p>;
+
+class ZZ_pContext {
+public:
+  ZZ_pContext() : modulus_(flint_modulus) {}
+  explicit ZZ_pContext(const ZZ& modulus) : modulus_(modulus) {}
+  void save() { modulus_ = flint_modulus; }
+  void restore() const { ZZ_p::init(modulus_); }
+private:
+  ZZ modulus_;
+};
+
+using ZZ_pX = FlintPolynomial<ZZ_p>;
+
+template <class T>
+class FlintMatrix {
+public:
+  FlintMatrix() = default;
+  void SetDims(long rows, long columns) {
+    rows_.assign(static_cast<std::size_t>(rows),
+                 std::vector<T>(static_cast<std::size_t>(columns)));
+  }
+  long NumRows() const { return static_cast<long>(rows_.size()); }
+  long NumCols() const { return rows_.empty() ? 0 : static_cast<long>(rows_[0].size()); }
+  std::vector<T>& operator[](long row) { return rows_[static_cast<std::size_t>(row)]; }
+  const std::vector<T>& operator[](long row) const { return rows_[static_cast<std::size_t>(row)]; }
+private:
+  std::vector<std::vector<T>> rows_;
+};
+
+using mat_ZZ = FlintMatrix<ZZ>;
+using mat_ZZ_p = FlintMatrix<ZZ_p>;
+using mat_zz_p = FlintMatrix<zz_p>;
+using mat_RR = FlintMatrix<double>;
+
+template <class Polynomial>
+struct FlintFactorPair {
+  Polynomial a;
+  long b = 0;
+};
+
+template <class Polynomial>
+inline std::ostream& operator<<(std::ostream& stream,
+                               const FlintFactorPair<Polynomial>& factor) {
+  return stream << "[" << factor.a << " " << factor.b << "]";
+}
+
+using pair_ZZX_long = FlintFactorPair<ZZX>;
+using pair_ZZ_pX_long = FlintFactorPair<ZZ_pX>;
+using vec_pair_ZZX_long = FlintVector<pair_ZZX_long>;
+using vec_pair_ZZ_pX_long = FlintVector<pair_ZZ_pX_long>;
+
+inline long deg(const ZZX& polynomial) {
+  return static_cast<long>(polynomial.rep.size()) - 1;
+}
+inline long deg(const ZZ_pX& polynomial) {
+  return static_cast<long>(polynomial.rep.size()) - 1;
+}
+inline ZZ coeff(const ZZX& polynomial, long index) {
+  return index >= 0 && index < static_cast<long>(polynomial.rep.size())
+    ? polynomial.rep[static_cast<std::size_t>(index)] : ZZ(0);
+}
+inline ZZ LeadCoeff(const ZZX& polynomial) { return coeff(polynomial, deg(polynomial)); }
+inline ZZ_p coeff(const ZZ_pX& polynomial, long index) {
+  return index >= 0 && index < static_cast<long>(polynomial.rep.size())
+    ? polynomial.rep[static_cast<std::size_t>(index)] : ZZ_p(0L);
+}
+inline ZZ_p LeadCoeff(const ZZ_pX& polynomial) {
+  return coeff(polynomial, deg(polynomial));
+}
+inline ZZ ConstTerm(const ZZX& polynomial) { return coeff(polynomial, 0); }
+inline ZZ_p ConstTerm(const ZZ_pX& polynomial) { return coeff(polynomial, 0); }
+inline void MakeMonic(ZZ_pX& polynomial) {
+  if (polynomial.rep.empty()) return;
+  const ZZ_p inverse = inv(polynomial.rep.back());
+  polynomial *= inverse;
+}
+template <class Coefficient>
+inline void divide(FlintPolynomial<Coefficient>& output,
+                   const FlintPolynomial<Coefficient>& numerator,
+                   const FlintPolynomial<Coefficient>& denominator) {
+  output = numerator / denominator;
+}
+
+template <class Coefficient>
+inline void SetCoeff(FlintPolynomial<Coefficient>& polynomial, long index,
+                     const Coefficient& coefficient = Coefficient(1)) {
+  if (index < 0) return;
+  if (polynomial.rep.size() <= static_cast<std::size_t>(index))
+    polynomial.rep.resize(static_cast<std::size_t>(index + 1));
+  polynomial.rep[static_cast<std::size_t>(index)] = coefficient;
+  polynomial.normalize();
+}
+
+template <class Coefficient, class Scalar,
+          std::enable_if_t<!std::is_same_v<std::decay_t<Scalar>, Coefficient>, int> = 0>
+inline void SetCoeff(FlintPolynomial<Coefficient>& polynomial, long index,
+                     const Scalar& coefficient) {
+  SetCoeff(polynomial, index, Coefficient(coefficient));
+}
+
+template <class Coefficient>
+inline void SetX(FlintPolynomial<Coefficient>& polynomial) {
+  polynomial.rep.assign({Coefficient(0), Coefficient(1)});
+}
+
+template <class Coefficient>
+inline FlintPolynomial<Coefficient> LeftShift(const FlintPolynomial<Coefficient>& polynomial,
+                                              long count) {
+  FlintPolynomial<Coefficient> out;
+  if (!polynomial.rep.empty()) {
+    out.rep.resize(polynomial.rep.size() + static_cast<std::size_t>(count));
+    std::copy(polynomial.rep.begin(), polynomial.rep.end(), out.rep.begin() + count);
+  }
+  return out;
+}
+
+inline ZZX diff(const ZZX& polynomial) {
+  ZZX out;
+  if (polynomial.rep.size() <= 1) return out;
+  out.rep.resize(polynomial.rep.size() - 1);
+  for (std::size_t index = 1; index < polynomial.rep.size(); ++index)
+    out.rep[index - 1] = polynomial.rep[index] * static_cast<long>(index);
+  out.normalize();
+  return out;
+}
+
+template <class Coefficient>
+inline std::ostream& output_polynomial(std::ostream& stream,
+                                      const FlintPolynomial<Coefficient>& polynomial) {
+  stream << "[";
+  for (std::size_t index = 0; index < polynomial.rep.size(); ++index) {
+    if (index) stream << " ";
+    stream << polynomial.rep[index];
+  }
+  return stream << "]";
+}
+
+inline std::ostream& operator<<(std::ostream& stream, const ZZX& polynomial) {
+  return output_polynomial(stream, polynomial);
+}
+inline std::ostream& operator<<(std::ostream& stream, const ZZ_pX& polynomial) {
+  return output_polynomial(stream, polynomial);
+}
+
+#endif
