+  fmpz_poly_init(gcd);
+  fmpz_poly_gcd(gcd, a, b);
+  ZZX output = from_flint(gcd);
+  fmpz_poly_clear(gcd);
+  fmpz_poly_clear(b);
+  fmpz_poly_clear(a);
+  return output;
+}
