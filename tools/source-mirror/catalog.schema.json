{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sagejs.org/schemas/source-catalog-v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema", "r2Prefix", "objects"],
  "properties": {
    "$schema": { "type": "string" },
    "schema": { "const": "sagejs.source-catalog/v2" },
    "r2Prefix": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+[^/]$" },
    "objects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "filename", "sha256", "upstreamUrls"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
          "filename": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]+$" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "platform": { "type": "string", "pattern": "^(linux|darwin)-(x64|arm64)$" },
          "archiveEnvironment": { "type": "string", "pattern": "^SAGEJS_[A-Z0-9_]+_TARBALL$" },
          "upstreamUrls": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "format": "uri", "pattern": "^https://" }
          }
        }
      }
    }
  }
}
