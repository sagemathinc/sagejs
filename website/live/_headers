/*
  Content-Security-Policy: default-src 'none'; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; worker-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; manifest-src 'self'; font-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'; media-src 'none'
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Resource-Policy: same-origin
  Origin-Agent-Cluster: ?1
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=(), browsing-topics=()
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-Permitted-Cross-Domain-Policies: none

/assets/*.wasm
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/wasm

/assets/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin

/embed/v1/*
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin

/embed/v1/frame.html
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; worker-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors *; form-action 'none'; media-src 'none'
  ! X-Frame-Options

/vendor/*
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin

/cell-controller.mjs
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin

/cell-session-pool.mjs
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin

/codemirror-editor.mjs
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin

/output-renderer.mjs
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin

/resource-policy.mjs
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin

/runtime-api.mjs
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin

/widget-manager.mjs
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin

/runtime-version.json
  Cache-Control: no-cache
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin

/sw.js
  Cache-Control: no-cache

/asset-manifest.json
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache
