class _Reflect:
    @staticmethod
    def apply(
        function: Any,
        receiver: Any,
        arguments: Sequence[Any],
    ) -> Any: ...

    @staticmethod
    def construct(
        constructor: Any,
        arguments: Sequence[Any],
        new_target: Any = ...,
    ) -> Any: ...

    @staticmethod
    def deleteProperty(target: Any, property_name: Any) -> bool: ...

    @staticmethod
    def get(
        target: Any,
        property_name: Any,
        receiver: Any = ...,
    ) -> Any: ...

    @staticmethod
    def has(target: Any, property_name: Any) -> bool: ...

    @staticmethod
    def set(
        target: Any,
        property_name: Any,
        value: Any,
        receiver: Any = ...,
    ) -> bool: ...


class _WeakRef:
    def deref(self) -> Any: ...


class _WeakRefClass:
    def __call__(self, target: object) -> _WeakRef: ...


class _FinalizationRegistry:
