        self,
        target: object,
        held_value: object,
        unregister_token: object = ...,
    ) -> None: ...

    def unregister(self, unregister_token: object) -> bool: ...


class _FinalizationRegistryClass:
    def __call__(
        self,
        callback: Callable[[object], None],
    ) -> _FinalizationRegistry: ...


class _Element:
