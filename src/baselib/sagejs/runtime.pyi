    def __call__(self, value: object) -> Any: ...


class _Object:
    prototype: Any

    def __call__(self, value: object = ...) -> Any: ...

    @staticmethod
    def assign(target: Any, *sources: Any) -> Any: ...

    @staticmethod
    def create(prototype: Any) -> Any: ...

    @staticmethod
    def defineProperties(value: object, properties: object) -> None: ...

    @staticmethod
