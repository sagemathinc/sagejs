{
  "schema": "sagejs.numerical-node-capability-spec/v1",
  "backend": {
    "id": "sagejs-numerical-product-artifacts",
    "version": "numerical-product-v8"
  },
  "capabilities": [
    {"id": "numerics.contracts", "case_ids": ["p0-result-contract"], "envelope": {"schema_version": 1, "numeric_type": "binary64"}},
    {"id": "numerics.root.scalar", "case_ids": ["p1-root-cosine", "p1-root-invalid-bracket", "p1-root-translation", "p8-root-resource-budget", "p8-callback-exception", "p8-cross-domain-repeated-stability", "p8-runtime-recovery"], "envelope": {"methods": ["bisection", "brent", "newton", "secant"], "callbacks": true, "bounded": true}},
    {"id": "numerics.approximation.interpolation", "case_ids": ["p2-interpolation-quadratic"], "envelope": {"methods": ["barycentric"], "numeric_type": "binary64"}},
    {"id": "numerics.approximation.splines", "case_ids": ["p2-cubic-spline-polynomial"], "envelope": {"methods": ["cubic-spline"], "boundaries": ["not-a-knot", "natural", "clamped", "periodic"], "numeric_type": "binary64"}},
    {"id": "numerics.approximation.finite_difference", "case_ids": ["p2-finite-difference-sine"], "envelope": {"methods": ["fornberg-central", "fornberg-forward", "fornberg-backward"], "maximum_derivative_order": 32, "numeric_type": "binary64"}},
    {"id": "numerics.approximation.chebyshev", "case_ids": ["p2-chebyshev-exponential"], "envelope": {"methods": ["chebyshev-direct-dct-ii"], "maximum_degree": 512, "truth_level": "heuristic", "numeric_type": "binary64"}},
    {"id": "numerics.approximation.polynomial_roots", "case_ids": ["p2-polynomial-roots-known", "p2-polynomial-roots-clustered"], "envelope": {"methods": ["aberth-ehrlich"], "maximum_degree": 64, "numeric_type": "complex-binary64", "multiplicity_policy": "numerical-clusters-only-never-certified"}},
    {"id": "numerics.integration.quadrature", "case_ids": ["p2-quadrature-sine", "p8-cross-domain-repeated-stability"], "envelope": {"methods": ["adaptive-gauss-kronrod"], "dimension": 1, "callbacks": true}},
    {"id": "numerics.linear.solve", "case_ids": ["p2-linear-solve", "p2-linear-scale-stress", "p2-linear-singular", "p8-cross-domain-repeated-stability"], "envelope": {"methods": ["lu", "qr", "cholesky"], "numeric_type": "binary64"}},
    {"id": "numerics.linear.factorizations", "case_ids": ["p2-linear-qr-factorization", "p2-linear-cholesky-factorization"], "envelope": {"methods": ["householder-qr", "cholesky"], "independent_validation": ["reconstruction", "orthogonality", "triangular-structure"], "numeric_type": "binary64"}},
    {"id": "numerics.optimization.scalar", "case_ids": ["p3-scalar-minimum", "p3-optimization-cancelled"], "envelope": {"methods": ["bounded-brent"], "callbacks": true, "bounded": true}},
    {"id": "numerics.optimization.cminpack", "case_ids": ["p3-cminpack-rosenbrock-lmdif", "p3-cminpack-rosenbrock-lmder", "p8-cminpack-cancelled"], "envelope": {"backend": "cminpack-wasm", "methods": ["cminpack-lmdif", "cminpack-lmder"], "maximum_variables": 256, "maximum_residuals": 16384, "callbacks": "synchronous-packed-linear-memory", "independent_validation_required": true}},
    {"id": "numerics.optimization.cminpack_optional_resource", "case_ids": ["p3-cminpack-optional-resource-fail-closed"], "envelope": {"backend": "cminpack-wasm", "selection": "explicit-only", "automatic_method": "damped-gauss-newton", "automatic_backend": "ordinary-python", "optional_resource_failures": ["missing", "corrupt"], "explicit_failure_status": "backend_failure", "explicit_failure_reason": "cminpack_backend_error", "private_resource_details": "hidden"}},
    {"id": "numerics.optimization.nlopt_nelder_mead", "case_ids": ["p3-nlopt-nelder-mead-rosenbrock", "p3-nlopt-nelder-mead-one-dimensional", "p3-nlopt-nelder-mead-zero-scale", "p3-nlopt-nelder-mead-saddle-rejected", "p3-nlopt-failure-provenance"], "envelope": {"backend": "nlopt-mit-wasm", "method": "nlopt-nelder-mead", "selection": "explicit-only", "maximum_variables": 128, "constraints": ["box_bounds"], "derivatives": "none", "independent_validation": ["objective", "bounds", "feasible_direction_local_minimum"], "execution_provenance": "external_library_wasm", "failed_execution_provenance": "external_library_wasm_after_backend_entry", "lazy_cache": "backend-specific-reuse"}},
    {"id": "numerics.optimization.nlopt_cobyla", "case_ids": ["p3-nlopt-cobyla-circle", "p3-nlopt-cobyla-infeasible-rejected", "p3-nlopt-cobyla-nonminimum-rejected"], "envelope": {"backend": "nlopt-mit-wasm", "method": "nlopt-cobyla", "selection": "explicit-only", "maximum_variables": 128, "maximum_constraints": 512, "constraints": ["box_bounds", "scalar_inequality", "scalar_equality"], "derivatives": "none", "independent_validation": ["objective", "bounds", "feasibility", "feasible_direction_local_minimum"], "positive_backend_status_is_not_mathematical_success": true}},
    {"id": "numerics.optimization.nlopt_optional_resource", "case_ids": ["p3-nlopt-optional-resource-fail-closed"], "envelope": {"backend": "nlopt-mit-wasm", "selection": "explicit-only", "automatic_method": "nelder-mead", "automatic_backend": "ordinary-python", "optional_resource_failures": ["missing", "corrupt"], "explicit_methods": ["nlopt-nelder-mead", "nlopt-cobyla"], "explicit_failure_status": "backend_failure", "explicit_failure_reason": "nlopt_backend_error", "private_resource_details": "hidden"}},
    {"id": "numerics.ode.explicit_ivp", "case_ids": ["p4-ode-exponential", "p4-ode-cancelled"], "envelope": {"methods": ["dormand-prince-54", "rk4"], "dense_output": true, "events": true}},
    {"id": "numerics.ode.stiff_ivp", "case_ids": ["p4-ode-stiff-decay"], "envelope": {"methods": ["rosenbrock4"], "algorithm_family": "kaps-rentrop-rosenbrock-4-3", "automatic_selection": false, "dense_jacobian": true}},
    {"id": "numerics.ode.sweeps", "case_ids": ["p4-ode-decay-sweep"], "envelope": {"scheduler": "bounded-batch-v1", "stable_order": true, "deterministic_seeds": true, "fallback_concurrency": 1}},
    {"id": "numerics.spectral.dense", "case_ids": ["p5-symmetric-eigen", "p5-general-eigen", "p5-singular-value-decomposition"], "envelope": {"methods": ["cyclic-jacobi", "hessenberg-implicit-double-shift-qr", "one-sided-jacobi-svd"], "numeric_type": "complex-binary64"}},
    {"id": "numerics.spectral.fft", "case_ids": ["p5-fft-direct-oracle", "p8-cross-domain-repeated-stability"], "envelope": {"methods": ["radix2-cooley-tukey", "bluestein-radix2"], "numeric_type": "complex-binary64"}},
    {"id": "numerics.spectral.convolution", "case_ids": ["p5-convolution-direct-oracle"], "envelope": {"methods": ["direct", "fft"], "modes": ["full", "same", "valid"], "numeric_type": "complex-binary64"}},
    {"id": "numerics.spectral.sparse", "case_ids": ["p5-sparse-linear-solve", "p5-sparse-dominant-eigen"], "envelope": {"formats": ["csr"], "solve_methods": ["cg", "bicgstab"], "eigen_methods": ["dominant-power"], "numeric_type": "complex-binary64"}},
    {"id": "numerics.statistics.descriptive", "case_ids": ["p5-statistics-summary", "p8-statistics-deterministic-fuzz", "p8-cross-domain-repeated-stability", "p8-memory-pressure-statistics"], "envelope": {"methods": ["corrected-two-pass"], "reproducible": true}},
    {"id": "numerics.statistics.inference", "case_ids": ["p5-statistics-inference"], "envelope": {"methods": ["one-sample-t", "welch-two-sample-t"], "independent_oracle": "definition-plus-pinned-mature-reference"}},
    {"id": "numerics.statistics.rng", "case_ids": ["p5-statistics-rng-replay"], "envelope": {"algorithm": "pcg32-xsh-rr-v1", "contract_version": 2, "json_safe_state": true, "deterministic_replay": true}},
    {"id": "numerics.statistics.regression", "case_ids": ["p5-statistics-linear-regression"], "envelope": {"methods": ["ordinary-least-squares", "theil-sen", "huber"], "independent_validation": ["centered-sums", "residuals"]}},
    {"id": "numerics.sweeps.bounded", "case_ids": ["p5-bounded-sweep"], "envelope": {"stable_order": true, "deterministic_seeds": true, "bounded_concurrency": true}},
    {"id": "numerics.frontend.scalar_root", "case_ids": ["p6-multilingual-root-roundtrip"], "envelope": {"languages": ["sage", "python-scipy", "matlab", "wolfram"], "classification": "translated"}},
    {"id": "numerics.frontend.catalog", "case_ids": ["p6-multilingual-catalog-roundtrip"], "envelope": {"operations": 22, "languages": ["sage", "python-scipy", "matlab", "wolfram"], "supported_emitters": 63, "structured_unsupported_targets": 25, "checked_source_roundtrip": true, "envelope_bound_emitters": 59, "language_parsed_scalar_root_emitters": 4, "classification": "translated"}},
    {"id": "numerics.frontend.parser_guards", "case_ids": ["p6-multilingual-parser-fail-closed"], "envelope": {"built_parsers": ["matlab", "wolfram"], "unsafe_mappings": "structured-positioned-unsupported", "safe_integral_forms": 2, "classification": "translated"}},
    {"id": "numerics.frontend.matlab_shapes", "case_ids": ["p6-matlab-vector-shapes"], "envelope": {"built_parser": "matlab", "executable_programs": 11, "one_output_vectors": "columns", "callback_parameters": "preserve-row-or-column-orientation", "container_shapes": ["convolution-row", "arrayfun-matrix"], "classification": "translated"}},
    {"id": "numerics.frontend.scipy_execution", "case_ids": ["p6-scipy-emitted-execution"], "envelope": {"external_runtime": "cpython-with-numpy-scipy", "programs": ["linear_solve", "integral", "minimum", "ode"], "emitted_by_bound_sagejs_artifact": true, "independent_host_oracles": true, "classification": "translated"}},
    {"id": "numerics.frontend.guardrails", "case_ids": ["p6-frontend-failure-and-expression-guards", "p6-frontend-resource-guards"], "envelope": {"failed_value_projection": "reject", "expression_validation": ["free-symbols", "arity", "finite-literals", "parameter-count", "callback-consistency"], "portable_resource_limits": ["depth", "node-count", "source-bytes", "envelope-depth"], "classification": "translated"}},
    {"id": "numerics.teaching.root", "case_ids": ["p7-root-teaching-artifacts"], "envelope": {"plot_spec": true, "animation": true, "bounded_trace": true}},
    {"id": "numerics.teaching.cross_domain", "case_ids": ["p7-cross-domain-teaching-artifacts"], "envelope": {"domains": ["approximation", "integration", "linear-algebra", "ode", "optimization", "spectral", "statistics"], "plot_spec": true, "animation": true, "renderer_neutral": true, "bounded": true, "retained_evidence_without_callback_replay": true, "cross_platform_comparison": "semantic-with-explicit-numeric-tolerances-not-byte-identity"}},
    {"id": "numerics.teaching.scalar_optimization", "case_ids": ["p7-scalar-optimization-retained-view"], "envelope": {"operation": "scalar_minimum", "plot_spec": true, "animation": true, "repeated_views": true, "callback_replay": false, "maximum_frames": 128}},
    {"id": "numerics.lifecycle.repeated", "case_ids": ["p8-cross-domain-repeated-stability"], "envelope": {"same_session": true, "deterministic_observations": true, "trials": 64}},
    {"id": "numerics.lifecycle.recovery", "case_ids": ["p8-runtime-recovery"], "envelope": {"contained_callback_failure": true, "post_failure_execution": true, "browser_worker_replacement": true}},
    {"id": "numerics.lifecycle.memory", "case_ids": ["p8-memory-pressure-statistics"], "envelope": {"bounded_samples": 131072, "collector_metrics": ["rss_peak_sampled_bytes", "process_max_rss_bytes", "artifact_installed_bytes"]}},
    {"id": "numerics.optimization.polynomial_least_squares", "status": "unavailable", "reason": "reserved for a future least-squares frontend over the qualified cminpack core", "case_ids": [], "envelope": null},
    {"id": "numerics.ode.stiff_sparse", "status": "unavailable", "reason": "reserved for a future sparse-Jacobian stiff ODE backend", "case_ids": [], "envelope": null}
  ]
}
