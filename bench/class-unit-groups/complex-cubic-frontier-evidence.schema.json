{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sagejs.org/schemas/benchmarks/complex-cubic-frontier-evidence.schema.json",
  "title": "Complex cubic census and retained timing evidence",
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nullableDigest": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "nanoseconds": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "system": { "enum": ["sagejs", "pari", "magma", "hecke"] },
    "boundary": { "enum": ["scalar-prepared", "fresh-complete"] },
    "terminalStatus": { "enum": ["ok", "timeout", "error", "unavailable"] },
    "censusTool": {
      "type": "object", "additionalProperties": false,
      "required": ["system", "adapter_kind", "requested", "executable", "executable_sha256", "version", "status"],
      "properties": {
        "system": { "$ref": "#/$defs/system" },
        "adapter_kind": { "enum": ["generated-sagejs-python", "generated-direct-gp", "json-protocol", "missing"] },
        "requested": { "type": ["string", "null"] },
        "executable": { "type": ["string", "null"] },
        "executable_sha256": { "$ref": "#/$defs/nullableDigest" },
        "version": { "type": ["string", "null"] },
        "status": { "enum": ["available", "unavailable"] }
      }
    },
    "censusProcess": {
      "type": "object", "additionalProperties": false,
      "required": [
        "system", "mode", "round", "census_shard", "record_labels_sha256", "status",
        "response_validation_error", "generated_program_sha256",
        "launched_monotonic_nanoseconds", "ended_monotonic_nanoseconds",
        "launch_to_ready_nanoseconds", "process_wall_nanoseconds", "timeout_seconds",
        "affinity_logical_cpus", "peak_rss_bytes", "stderr_sha256", "runtime_identity",
        "runtime_closure_sha256"
      ],
      "properties": {
        "system": { "$ref": "#/$defs/system" },
        "mode": { "const": "census" },
        "round": { "type": "null" },
        "census_shard": {
          "oneOf": [
            { "type": "integer", "minimum": 0, "maximum": 19 },
            { "type": "null" }
          ]
        },
        "record_labels_sha256": { "$ref": "#/$defs/digest" },
        "status": { "$ref": "#/$defs/terminalStatus" },
        "response_validation_error": { "type": ["string", "null"] },
        "generated_program_sha256": { "$ref": "#/$defs/digest" },
        "launched_monotonic_nanoseconds": { "$ref": "#/$defs/nanoseconds" },
        "ended_monotonic_nanoseconds": { "$ref": "#/$defs/nanoseconds" },
        "launch_to_ready_nanoseconds": {
          "oneOf": [{ "$ref": "#/$defs/nanoseconds" }, { "type": "null" }]
        },
        "process_wall_nanoseconds": { "$ref": "#/$defs/nanoseconds" },
        "timeout_seconds": { "type": "integer", "minimum": 1 },
        "affinity_logical_cpus": {
          "type": "array", "minItems": 1, "maxItems": 1,
          "items": { "type": "integer", "minimum": 0 }
        },
        "peak_rss_bytes": { "type": ["string", "null"], "pattern": "^[1-9][0-9]*$" },
        "stderr_sha256": { "$ref": "#/$defs/digest" },
        "runtime_identity": { "type": ["object", "null"] },
        "runtime_closure_sha256": { "$ref": "#/$defs/nullableDigest" }
      }
    },
    "censusSummary": {
      "type": "object", "additionalProperties": false,
      "required": ["counts", "agreement", "coverage_complete", "processes"],
      "properties": {
        "counts": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "agreement": { "type": "boolean" },
        "coverage_complete": { "type": "boolean" },
        "processes": { "type": "array", "items": { "$ref": "#/$defs/censusProcess" } }
      }
    },
    "timingEvent": {
      "type": "object", "additionalProperties": false,
      "required": [
        "round", "order_position", "system", "boundary", "shard", "proof",
        "status", "iterations", "record_count", "root_nanoseconds", "root_source",
        "phase_sum_used", "digest_inside_root", "answer_digest", "per_field_nanoseconds"
      ],
      "properties": {
        "round": { "type": "integer", "minimum": 0, "maximum": 10 },
        "order_position": { "type": "integer", "minimum": 0, "maximum": 3 },
        "system": { "$ref": "#/$defs/system" },
        "boundary": { "$ref": "#/$defs/boundary" },
        "shard": { "type": "integer", "minimum": 0, "maximum": 19 },
        "proof": { "const": "conditional-grh" },
        "status": { "$ref": "#/$defs/terminalStatus" },
        "iterations": { "type": "integer", "minimum": 0 },
        "record_count": { "type": "integer", "minimum": 0, "maximum": 50 },
        "root_nanoseconds": { "oneOf": [{ "$ref": "#/$defs/nanoseconds" }, { "type": "null" }] },
        "root_source": { "const": "one-contiguous-monotonic-timer" },
        "phase_sum_used": { "const": false },
        "digest_inside_root": { "const": false },
        "answer_digest": { "$ref": "#/$defs/nullableDigest" },
        "per_field_nanoseconds": { "type": "array", "items": { "type": "string", "pattern": "^[0-9]+$" } }
      }
    }
  },
  "oneOf": [
    {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "schema_version", "recorded_at", "corpus", "source", "host", "proof_contract", "systems", "tools", "execution", "records", "summary"],
      "properties": {
        "schema": { "const": "sagejs.benchmark/complex-cubic-frontier-census-v1" },
        "schema_version": { "const": 1 },
        "recorded_at": { "type": "string", "format": "date-time" },
        "corpus": { "type": "object" },
        "source": { "type": "object" },
        "host": { "type": "object" },
        "proof_contract": { "type": "object" },
        "systems": { "type": "array", "items": { "$ref": "#/$defs/system" } },
        "tools": { "type": "array", "items": { "$ref": "#/$defs/censusTool" } },
        "execution": {
          "type": "object", "additionalProperties": false,
          "required": ["scheduler", "direct_cpus", "external_cpu", "max_live_processes_per_cpu", "timing_authority"],
          "properties": {
            "scheduler": { "const": "static-shard-modulo-cpu-list-v1" },
            "direct_cpus": {
              "type": "array", "minItems": 1, "uniqueItems": true,
              "items": { "type": "integer", "minimum": 0 }
            },
            "external_cpu": { "type": "integer", "minimum": 0 },
            "max_live_processes_per_cpu": { "const": 1 },
            "timing_authority": { "const": "none-census-is-non-authoritative" }
          }
        },
        "records": { "type": "array", "minItems": 1000, "maxItems": 1000, "items": { "type": "object" } },
        "summary": { "$ref": "#/$defs/censusSummary" }
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "schema_version", "recorded_at", "corpus", "census", "source", "host", "protocol", "tools", "processes", "events", "metrics"],
      "properties": {
        "schema": { "const": "sagejs.benchmark/complex-cubic-frontier-timing-v1" },
        "schema_version": { "const": 1 },
        "recorded_at": { "type": "string", "format": "date-time" },
        "corpus": { "type": "object" },
        "census": { "type": "object" },
        "source": { "type": "object" },
        "host": { "type": "object" },
        "protocol": { "type": "object" },
        "tools": { "type": "array", "items": { "type": "object" } },
        "processes": { "type": "array", "items": { "type": "object" } },
        "events": { "type": "array", "items": { "$ref": "#/$defs/timingEvent" } },
        "metrics": { "type": "object" }
      }
    }
  ]
}
