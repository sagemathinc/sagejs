{
  "schema": "sagejs.rust-class-group/benchmark-config-v1",
  "benchmarkId": "exact-rust-pari-2174-prepared-cubics",
  "boundary": {
    "kind": "prepared-field",
    "label": "prepared-field/complete-grh-class-unit-v1",
    "includedWork": [
      "replay-validated prepared cubic through class group, compact units, regulator enclosure, and conditional analytic index-one completion"
    ],
    "excludedWork": [
      "polynomial validation and maximal-order preparation",
      "adapter process startup, result projection, and JSON serialization"
    ],
    "proofMode": "conditional-grh",
    "outputPolicy": "complete class-and-unit computation with exact common class-number and invariant-factor projection"
  },
  "schedule": "alternating-pairs-v1",
  "warmupsPerArm": 1,
  "samplesPerArm": 15,
  "timeoutMilliseconds": 120000,
  "seedPrefix": "exact-prepared-cubics-v1",
  "receiptPath": "results/prepared-cubic-campaign.receipt.json",
  "evidenceDirectory": "results/prepared-cubic-campaign.evidence",
  "identityCommands": [
    { "id": "rustc", "command": ["rustc", "--version", "--verbose"] },
    { "id": "cargo", "command": ["cargo", "--version", "--verbose"] },
    { "id": "cc", "command": ["cc", "--version"] },
    { "id": "pari-control", "command": ["python3", "../pari-control/identity.py"] }
  ],
  "fields": [
    {
      "id": "h1-real-cubic",
      "input": "../row6-candidate/inputs/h1-neutral-prepared-field.json"
    },
    {
      "id": "row1-index-3-cubic",
      "input": "../row6-candidate/inputs/row1-neutral-prepared-field.json"
    },
    {
      "id": "row6-continuation-cubic",
      "input": "../row6-candidate/inputs/row6-neutral-prepared-field.json"
    }
  ],
  "arms": [
    {
      "id": "rust",
      "implementation": "Exact Rust prepared-cubic GRH-conditional class-and-unit engine",
      "boundaryLabel": "prepared-field/complete-grh-class-unit-v1",
      "command": [
        "./run-rust-prepared.py",
        "--input", "{input}",
        "--field-id", "{fieldId}",
        "--seed", "{seed}"
      ],
      "artifactPaths": [
        "./run-rust-prepared.py",
        "../row6-candidate/target/release/sagejs-row6-rust-candidate-diagnostic",
        "../row6-candidate/Cargo.toml",
        "../row6-candidate/Cargo.lock"
      ],
      "durationPointer": "/kernelNanoseconds",
      "stageTimingsPointer": "/stageTimingsNanoseconds",
      "peakRssKiBPointer": "/processPeakRssKiB",
      "resultProjection": {
        "classNumber": "/result/classNumber",
        "invariantFactors": "/result/invariantFactors"
      }
    },
    {
      "id": "pari",
      "implementation": "Authenticated pristine PARI 2.17.4 prepared bnfinit flag-zero class-and-unit control",
      "boundaryLabel": "prepared-field/complete-grh-class-unit-v1",
      "command": [
        "./run-pari-prepared.py",
        "--input", "../corpus/initial-open-development-v1.json",
        "--field-id", "{fieldId}",
        "--seed", "{seed}"
      ],
      "artifactPaths": [
        "./run-pari-prepared.py",
        "../pari-control/build/pari-control",
        "../pari-control/build/build-identity.json",
        "../pari-control/pinned-identity.json"
      ],
      "durationPointer": "/kernelNanoseconds",
      "stageTimingsPointer": "/stageTimingsNanoseconds",
      "peakRssKiBPointer": "/processPeakRssKiB",
      "resultProjection": {
        "classNumber": "/result/classNumber",
        "invariantFactors": "/result/invariantFactors"
      }
    }
  ]
}
