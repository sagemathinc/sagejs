{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sagejs.org/schemas/rust-class-group-lifecycle-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "claim", "artifact", "repeatedCalls", "malformedInput", "lifecycle", "termination", "resumableContext", "transactionalPublication", "cancellation", "requiredInputChange", "campaignCoverage"],
  "properties": {
    "schema": { "const": "sagejs.rust-class-group-lifecycle/v1" },
    "status": { "enum": ["small-candidate-context-pass-medium-unqualified", "failed-required-input-validation"] },
    "claim": { "$ref": "#/$defs/claim" },
    "artifact": { "$ref": "#/$defs/artifact" },
    "repeatedCalls": { "$ref": "#/$defs/repeatedCalls" },
    "malformedInput": { "$ref": "#/$defs/malformedInput" },
    "lifecycle": { "$ref": "#/$defs/lifecycle" },
    "termination": { "$ref": "#/$defs/termination" },
    "resumableContext": { "$ref": "#/$defs/resumableContext" },
    "transactionalPublication": { "$ref": "#/$defs/transactionalPublication" },
    "cancellation": { "$ref": "#/$defs/cancellation" },
    "requiredInputChange": { "$ref": "#/$defs/requiredInputChange" },
    "campaignCoverage": { "$ref": "#/$defs/campaignCoverage" }
  },
  "$defs": {
    "claim": {
      "type": "object", "additionalProperties": false,
      "required": ["productionQualified", "artifactScope", "mathematicalCompletionClaim"],
      "properties": {
        "productionQualified": { "const": false },
        "artifactScope": { "type": "string", "minLength": 1 },
        "mathematicalCompletionClaim": { "const": false }
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "bytes", "sha256", "abiVersion", "sourceInputs"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "abiVersion": { "const": 1 },
        "sourceInputs": {
          "type": "array", "minItems": 6, "maxItems": 6,
          "items": { "$ref": "#/$defs/fileIdentity" }
        }
      }
    },
    "fileIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "repeatedCalls": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "count", "exactResultSha256", "initialMemoryPages", "memoryPageObservations", "stabilizedAfterCall", "stableMemoryPages", "stableMemoryMinimumPages", "stableMemoryMaximumPages", "pagesAfterMalformedRecovery"],
      "properties": {
        "status": { "const": "pass" },
        "count": { "type": "integer", "minimum": 16 },
        "exactResultSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "initialMemoryPages": { "type": "integer", "minimum": 1 },
        "memoryPageObservations": {
          "type": "array", "minItems": 9,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["call", "pages"],
            "properties": {
              "call": { "type": "integer", "minimum": 1 },
              "pages": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "stabilizedAfterCall": { "type": "integer", "minimum": 1 },
        "stableMemoryPages": { "type": "integer", "minimum": 1 },
        "stableMemoryMinimumPages": { "type": "integer", "minimum": 1 },
        "stableMemoryMaximumPages": { "type": "integer", "minimum": 1 },
        "pagesAfterMalformedRecovery": { "type": "integer", "minimum": 1 }
      }
    },
    "malformedInput": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "cases", "incorrectlyAccepted", "validCallAfterErrors", "trapsObserved"],
      "properties": {
        "status": { "enum": ["pass", "fail"] },
        "cases": {
          "type": "array", "minItems": 13,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "status"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "status": { "enum": ["structured-error", "rejected-before-allocation", "incorrectly-accepted", "host-exception"] },
              "error": { "type": "string", "minLength": 1 },
              "returnedSchema": { "type": ["string", "null"] }
            }
          }
        },
        "incorrectlyAccepted": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "validCallAfterErrors": { "const": "pass" },
        "trapsObserved": { "const": 0 }
      }
    },
    "lifecycle": {
      "type": "object", "additionalProperties": false,
      "required": ["hostClose", "staleUseAfterClose", "guestHandlesPresent", "guestStaleHandleTest", "guestDoubleDropTest", "rawDoubleDeallocTest"],
      "properties": {
        "hostClose": { "const": "pass-idempotent" },
        "staleUseAfterClose": { "const": "pass-rejected" },
        "guestHandlesPresent": { "const": true },
        "guestStaleHandleTest": { "const": "pass-rejected" },
        "guestDoubleDropTest": { "const": "pass-rejected" },
        "rawDoubleDeallocTest": { "const": "not-run-undefined-behavior-in-current-abi" }
      }
    },
    "termination": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "mechanism", "exitCode", "begunObserved", "resultPublished", "scope"],
      "properties": {
        "status": { "const": "pass" },
        "mechanism": { "const": "node-worker-hard-termination" },
        "exitCode": { "type": "integer" },
        "begunObserved": { "const": true },
        "resultPublished": { "const": false },
        "scope": { "type": "string", "minLength": 1 }
      }
    },
    "transactionalPublication": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "observation", "durableState"],
      "properties": {
        "status": { "const": "pass-small-context-and-hard-worker-termination" },
        "observation": { "type": "string", "minLength": 1 },
        "durableState": { "const": "none" }
      }
    },
    "cancellation": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "cooperative", "reason", "hardWorkerTerminationAvailable", "implementedAbi", "cancellationBoundary", "nonInterruptibleSections", "remainingLimitation"],
      "properties": {
        "status": { "const": "pass-small-candidate-only" },
        "cooperative": { "const": true },
        "reason": { "type": "string", "minLength": 1 },
        "hardWorkerTerminationAvailable": { "const": true },
        "implementedAbi": { "type": "array", "minItems": 6, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "cancellationBoundary": { "type": "string", "minLength": 1 },
        "nonInterruptibleSections": { "type": "array", "minItems": 3, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "remainingLimitation": { "type": "string", "minLength": 1 }
      }
    },
    "resumableContext": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "pointBudgetPerYield", "completionSteps", "maximumStepMilliseconds", "cancellation", "staleAndMalformedHandles", "retiredHandleOperations", "doubleClose", "reset", "invalidResetTransactional", "contextCapacity", "mixedSmallJobs"],
      "properties": {
        "status": { "const": "pass-small-candidate" },
        "pointBudgetPerYield": { "const": 1 },
        "completionSteps": { "type": "integer", "minimum": 101 },
        "maximumStepMilliseconds": { "type": "number", "minimum": 0 },
        "cancellation": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "requestedCode", "terminalStatus", "latencyMilliseconds", "resultBeforeComplete", "resultAfterCancel", "partialResultPublished"],
          "properties": {
            "status": { "const": "pass" },
            "requestedCode": { "const": 1 },
            "terminalStatus": { "const": 3 },
            "latencyMilliseconds": { "type": "number", "minimum": 0, "maximum": 100 },
            "resultBeforeComplete": { "const": "structured-error" },
            "resultAfterCancel": { "const": "structured-error" },
            "partialResultPublished": { "const": false }
          }
        },
        "staleAndMalformedHandles": { "const": "pass" },
        "retiredHandleOperations": {
          "type": "object", "additionalProperties": false,
          "required": ["afterClose", "afterReset"],
          "properties": {
            "afterClose": { "$ref": "#/$defs/retiredOperations" },
            "afterReset": { "$ref": "#/$defs/retiredOperations" }
          }
        },
        "doubleClose": { "const": "pass-rejected" },
        "reset": { "const": "pass-generation-invalidates-prior-handle" },
        "invalidResetTransactional": { "const": "pass-original-context-remains-live" },
        "contextCapacity": {
          "type": "object", "additionalProperties": false,
          "required": ["maximumLive", "overflowCreateResult", "allAllocatedContextsClosed"],
          "properties": {
            "maximumLive": { "const": 64 },
            "overflowCreateResult": { "const": "zero-handle" },
            "allAllocatedContextsClosed": { "const": true }
          }
        },
        "mixedSmallJobs": {
          "type": "object", "additionalProperties": false,
          "required": ["count", "modes", "stableMemoryPages"],
          "properties": {
            "count": { "const": 100 },
            "modes": { "type": "array", "minItems": 3, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
            "stableMemoryPages": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "retiredOperations": {
      "type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true,
      "items": { "enum": ["step", "cancel", "result-state-error", "reset", "close"] }
    },
    "requiredInputChange": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "rule"],
      "properties": {
        "status": { "enum": ["required", "not-required"] },
        "rule": { "type": "string", "minLength": 1 }
      }
    },
    "campaignCoverage": {
      "type": "object", "additionalProperties": false,
      "required": ["repeatedSmallCalls", "mixedMediumCalls", "precisionFailure", "arithmeticCapacityFailure", "concurrentIndependentJobs", "nativeLeakSanitizer", "actualBrowserLifecycle"],
      "properties": {
        "repeatedSmallCalls": { "$ref": "#/$defs/countCoverage" },
        "mixedMediumCalls": { "$ref": "#/$defs/countCoverage" },
        "precisionFailure": { "type": "string", "minLength": 1 },
        "arithmeticCapacityFailure": { "type": "string", "minLength": 1 },
        "concurrentIndependentJobs": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "jobs", "identicalResults"],
          "properties": {
            "status": { "const": "pass-small-artifact-only" },
            "jobs": { "type": "integer", "minimum": 2 },
            "identicalResults": { "const": true }
          }
        },
        "nativeLeakSanitizer": { "type": "string", "minLength": 1 },
        "actualBrowserLifecycle": { "type": "string", "minLength": 1 }
      }
    },
    "countCoverage": {
      "type": "object", "additionalProperties": false,
      "required": ["required", "observed", "status"],
      "properties": {
        "required": { "type": "integer", "minimum": 1 },
        "observed": { "type": "integer", "minimum": 0 },
        "status": { "type": "string", "minLength": 1 }
      }
    }
  }
}
