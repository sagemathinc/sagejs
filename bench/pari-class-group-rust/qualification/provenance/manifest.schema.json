{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sagejs.org/schemas/rust-class-group-provenance-v1.json",
  "title": "Rust class-group provenance inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "scope",
    "project_license_expression",
    "legal_conclusion",
    "inputs",
    "upstream_sources",
    "modules",
    "cargo_packages",
    "foreign_dependencies",
    "known_gaps"
  ],
  "properties": {
    "schema": { "const": "sagejs.rust-class-group.provenance/v1" },
    "scope": { "type": "string", "minLength": 1 },
    "project_license_expression": { "type": "string", "minLength": 1 },
    "legal_conclusion": { "const": false },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cargo_toml", "cargo_lock", "build_rs", "native_dependency_declarations"],
      "properties": {
        "cargo_toml": { "$ref": "#/$defs/repositoryFile" },
        "cargo_lock": { "$ref": "#/$defs/repositoryFile" },
        "build_rs": { "$ref": "#/$defs/repositoryFile" },
        "native_dependency_declarations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/repositoryFile" }
        }
      }
    },
    "upstream_sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/upstreamSource" }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/module" }
    },
    "cargo_packages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/cargoPackage" }
    },
    "foreign_dependencies": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/foreignDependency" }
    },
    "known_gaps": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "repositoryFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "upstreamSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "project", "version", "relative_path", "sha256", "license_expression", "license_evidence"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9._-]+$" },
        "project": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "relative_path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "license_expression": { "type": "string", "minLength": 1 },
        "license_evidence": { "type": "string", "minLength": 1 }
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "symbols", "line_ranges", "evidence", "confidence"],
      "properties": {
        "source_id": { "type": "string", "minLength": 1 },
        "symbols": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "line_ranges": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[0-9]+-[0-9]+$" }
        },
        "evidence": { "type": "string", "minLength": 1 },
        "confidence": { "enum": ["authenticated", "documented", "tentative"] }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "classification", "declared_license_expression", "mapping_status", "mappings", "missing_mapping_explanation", "notes"],
      "properties": {
        "path": { "type": "string", "pattern": "^bench/pari-class-group-rust/src/.+\\.(rs|c)$" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "classification": { "enum": ["original", "behavioral_reimplementation", "source_translation_adaptation"] },
        "declared_license_expression": { "type": "string", "minLength": 1 },
        "mapping_status": { "enum": ["complete", "partial", "missing", "not_applicable"] },
        "mappings": { "type": "array", "items": { "$ref": "#/$defs/mapping" } },
        "missing_mapping_explanation": { "type": ["string", "null"] },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "cargoPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "source", "checksum", "license_expression", "license_evidence", "repository"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "source": { "type": ["string", "null"] },
        "checksum": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "license_expression": { "type": ["string", "null"] },
        "license_evidence": { "enum": ["cargo_package_manifest", "crate_source_headers"] },
        "repository": { "type": ["string", "null"] }
      }
    },
    "foreignDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "route", "link_name", "source_url", "source_sha256", "license_expression", "license_evidence", "applicability", "notes"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "route": { "enum": ["cargo_default", "flint_normal_form_feature", "incorporated_component"] },
        "link_name": { "type": ["string", "null"] },
        "source_url": { "type": "string", "minLength": 1 },
        "source_sha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "license_expression": { "type": ["string", "null"] },
        "license_evidence": { "enum": ["crate_bundle", "upstream_archive_declaration", "inherited_distribution"] },
        "applicability": { "type": "string", "minLength": 1 },
        "notes": { "type": "string", "minLength": 1 }
      }
    }
  }
}
