{
  "schema": "sagejs.browser-wasm-performance-cases/v1",
  "description": "A small release-performance profile. These are workloads, not substitutes for the complete browser parity corpus.",
  "cases": [
    {
      "id": "exact-matrix-kernel",
      "family": "exact-arithmetic",
      "requires": [
        { "id": "ffi:flint:fmpz_matrix_det", "route": "receipt-backed-wasm-artifact" },
        { "id": "ffi:flint:fmpz_matrix_hnf", "route": "receipt-backed-wasm-artifact" }
      ],
      "source": "A = matrix(ZZ, 12, 12, lambda i,j: (i+2)*(j+3) + (1 if i == j else 0))\nprint(A.det())\nprint(A.hermite_form()[0,0])",
      "timeout_ms": 60000
    },
    {
      "id": "cubic-number-field-zeta-1000",
      "family": "number-fields",
      "requires": [
        { "id": "kernel:number-field-zeta-coefficients-production", "route": "receipt-backed-wasm-artifact" },
        { "id": "napi:@sagemath/sagejs-flint:nfFactorDegreesBatch", "route": "receipt-backed-wasm-artifact" }
      ],
      "source": "R.<x> = QQ[]\nK.<a> = NumberField(x^3-x-1)\nO = K.maximal_order()\ncoefficients = K.zeta_function().coefficients(1000)\nprint(O.discriminant(), len(coefficients), sum(coefficients[:32]))",
      "timeout_ms": 180000
    },
    {
      "id": "analytic-special-value-batches",
      "family": "analytic-functions",
      "requires": [
        { "id": "analytic:riemann-zeta-batch", "route": "receipt-backed-wasm-artifact" },
        { "id": "analytic:dirichlet-l-batch", "route": "receipt-backed-wasm-artifact" }
      ],
      "source": "points = [CC(2, k/8) for k in range(-16,17)]\nR = RiemannZeta(80)\nG = DirichletGroup(5)\nD = G[2].lfunction(80)\nP.<x> = PolynomialRing(QQ)\nK.<a> = NumberField(x^2 - 5)\nZ = K.zeta_function(prec=80)\nvalues = R.values(points) + D.values(points) + Z.values(points)\nprint(len(values), float(values[0].real()), float(values[-1].real()))",
      "timeout_ms": 180000
    },
    {
      "id": "analytic-gamma-xi-batches",
      "family": "analytic-functions",
      "requires": [
        { "id": "analytic:complex-gamma", "route": "receipt-backed-wasm-artifact" },
        { "id": "analytic:riemann-xi", "route": "receipt-backed-wasm-artifact" }
      ],
      "source": "points=[[\"0.5\",(k-64)/16] for k in range(128)]\ngamma_values=complex_gamma_values(points,prec=160)\nxi_values=riemann_xi_values(points,prec=160)\nprint(len(gamma_values),len(xi_values),gamma_values[0].precision(),xi_values[-1].precision())",
      "timeout_ms": 180000
    },
    {
      "id": "numeric-mpfr-symbolic",
      "family": "numerical",
      "requires": [
        { "id": "napi:@sagemath/sagejs-flint:realDiv", "route": "receipt-backed-wasm-artifact" },
        { "id": "specialist:symbolic-numerical-integral-wasm", "route": "receipt-backed-wasm-artifact" },
        { "id": "specialist:symbolic-find-root-wasm", "route": "receipt-backed-wasm-artifact" }
      ],
      "source": "R=RealField(100)\nx=R(1)/R(3)\nfor k in range(100): x=(x+R(1))/R(3)\nt=var('t')\nvalue=numerical_integral(exp(t^2),1,2,eps_abs=1e-12,eps_rel=1e-12)[0]\nroot=(t^2-2).find_root(1,2)\nprint(x,float(value),float(root))",
      "timeout_ms": 180000
    },
    {
      "id": "moebius-range-100000",
      "family": "combinatorics-number-theory",
      "requires": [
        { "id": "kernel:packed-moebius-range-production", "route": "receipt-backed-wasm-artifact" }
      ],
      "source": "values=moebius.range(100000)\nprint(len(values),sum(values),sum(abs(x) for x in values))",
      "timeout_ms": 180000
    },
    {
      "id": "graph-components-10000",
      "family": "graphs",
      "requires": [
        { "id": "kernel:packed-graph-components-production", "route": "receipt-backed-wasm-artifact" }
      ],
      "source": "G=graphs.CycleGraph(10000)\nC=G.connected_components()\nprint(len(C),len(C[0]))",
      "timeout_ms": 180000
    },
    {
      "id": "gf2-matrix-384",
      "family": "dense-binary-matrices",
      "requires": [
        { "id": "ffi:m4ri:matrix_mul", "route": "receipt-backed-wasm-artifact" },
        { "id": "ffi:m4ri:matrix_rank", "route": "receipt-backed-wasm-artifact" }
      ],
      "source": "A=matrix(GF(2),384,384,lambda i,j:(i*17+j*31+i*j)%2)\nB=A*A\nprint(B.nrows(),B.ncols(),A.rank(),B.rank())",
      "timeout_ms": 180000
    },
    {
      "id": "matrix-combinatorial-invariants",
      "family": "combinatorics",
      "requires": [
        { "id": "kernel:packed-combinatorial-integer-rational-production", "route": "receipt-backed-wasm-artifact" },
        { "id": "kernel:packed-combinatorial-prime-production", "route": "receipt-backed-wasm-artifact" }
      ],
      "source": "from sagejs.linear_algebra.combinatorial import matrix_permanent,matrix_minors\nfor base in [ZZ,QQ,GF(7)]:\n A=matrix(base,8,8,[base((i*7+3)%11-5) for i in range(64)])\n B=matrix(base,6,7,[base((i*7+3)%11-5) for i in range(42)])\n print(matrix_permanent(A),len(matrix_minors(B,3)))",
      "timeout_ms": 180000
    },
    {
      "id": "extension-field-polynomial-5632",
      "family": "extension-fields",
      "requires": [
        { "id": "ffi:flint:fq_context", "route": "receipt-backed-wasm-artifact" },
        { "id": "ffi:flint:fq_polynomial_mul", "route": "receipt-backed-wasm-artifact" }
      ],
      "source": "P.<t>=PolynomialRing(GF(65537))\nK.<a>=GF(65537^3,modulus=t^3+t+1)\nR.<x>=PolynomialRing(K)\nf=x^256+(a+1)*x+2\nfor k in range(4): f=f*(x^1024+a+K(k+1))\nprint(f.degree(),f[0],f[f.degree()])",
      "timeout_ms": 240000
    },
    {
      "id": "algebraic-matrix-8",
      "family": "algebraic-numbers",
      "requires": [
        { "id": "algebraic:qqbar-resource-core", "route": "receipt-backed-wasm-artifact" }
      ],
      "source": "R.<x>=QQ[]\nr=(x^2-2).roots(AA,multiplicities=False)[1]\nM=matrix(AA,8,8,lambda i,j:r if i==j else AA((i+2*j)%5-2))\nprint(M.rank(),M.det(),(M*M).charpoly()[0])",
      "timeout_ms": 240000
    },
    {
      "id": "elliptic-lseries-value-batch",
      "family": "elliptic-curves",
      "requires": [
        { "id": "specialist:integer-factorization-wasm", "route": "receipt-backed-wasm-artifact" },
        { "id": "elliptic-coefficients-smalljac-wasm", "route": "receipt-backed-wasm-artifact" },
        { "id": "elliptic-lseries-values", "route": "receipt-backed-wasm-artifact" }
      ],
      "source": "E = EllipticCurve([0,0,1,-1,0])\nL = E.lseries()\npoints = [CC(1, k/8) for k in range(-16,17)]\nvalues = L.values(points, prec=53)\nprint(len(values), float(values[0].real()), float(values[-1].imag()))",
      "timeout_ms": 180000
    },
    {
      "id": "elliptic-lseries-complex-plot-64",
      "family": "plotting",
      "requires": [
        { "id": "specialist:integer-factorization-wasm", "route": "receipt-backed-wasm-artifact" },
        { "id": "elliptic-coefficients-smalljac-wasm", "route": "receipt-backed-wasm-artifact" },
        { "id": "elliptic-lseries-values", "route": "receipt-backed-wasm-artifact" },
        { "id": "elliptic-lseries-plot", "route": "receipt-backed-wasm-artifact" }
      ],
      "source": "E = EllipticCurve([0,0,1,-1,0])\nL = E.lseries()\npicture = complex_plot(L,(0,2),(-4,4),plot_points=64,interpolation='nearest')\nprint(picture._plot_spec_diagnostics[0]['pixel_count'])",
      "timeout_ms": 240000
    }
  ]
}
