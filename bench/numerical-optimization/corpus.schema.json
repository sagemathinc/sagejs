{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sagejs.org/schemas/numerical-optimization-corpus-v1.json",
  "title": "Sage.js numerical optimization corpus",
  "type": "object",
  "required": ["schema", "cases"],
  "properties": {
    "$schema": { "type": "string" },
    "schema": { "const": "sagejs.numerical-optimization-corpus/v1" },
    "description": { "type": "string" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "operation", "method", "problem", "input", "oracle", "acceptance", "benchmark"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "operation": { "type": "string", "minLength": 1 },
          "method": { "type": "string", "minLength": 1 },
          "problem": { "type": "string", "minLength": 1 },
          "input": { "type": "object" },
          "oracle": { "type": "object" },
          "acceptance": { "type": "object" },
          "benchmark": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
