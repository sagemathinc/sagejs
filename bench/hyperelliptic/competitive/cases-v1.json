      "contract": "canonical signed Mumford divisor",
      "model": {"genus": 2, "prime": "13", "f": ["1", "2", "0", "0", "0", "1"], "h": ["0"]},
      "left": {"u": ["1", "0", "1"], "v": ["6", "10"]},
      "right": {"u": ["5", "1"], "v": ["8"]},
      "expected": {"u": ["2", "5", "1"], "v": ["3", "9"]},
