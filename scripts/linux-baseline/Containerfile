ARG BUILD_IMAGE
FROM ${BUILD_IMAGE} AS node-build

ARG NODE_SOURCE_SHA256
ARG NODE_SOURCE_FILENAME
ARG NODE_SOURCE_URL
ARG NODE_VERSION
ARG PNPM_TARBALL_SHA512
ARG PNPM_TARBALL_URL
ARG RUST_SOURCE_FILENAME
ARG RUST_SOURCE_SHA256
ARG RUST_SOURCE_URL
ARG RUST_TARGET
ARG RUST_VERSION
ENV PATH=/opt/sagejs-rust/bin:/opt/rh/gcc-toolset-14/root/usr/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ENV LC_ALL=C
ENV SOURCE_DATE_EPOCH=0
ENV TZ=UTC
WORKDIR /build
RUN curl --fail --location --retry 3 \
      "${RUST_SOURCE_URL}" \
      --output rust.tar.xz \
 && printf '%s  %s\n' "${RUST_SOURCE_SHA256}" rust.tar.xz | sha256sum --check --strict \
 && tar -xJf rust.tar.xz \
 && "./rust-${RUST_VERSION}-${RUST_TARGET}/install.sh" \
      --prefix=/opt/sagejs-rust \
      --disable-ldconfig \
 && rustc --version | grep -Fx "rustc ${RUST_VERSION} (05f9846f8 2025-03-31)" \
 && cargo --version | grep -Fx "cargo ${RUST_VERSION} (adf9b6ad1 2025-02-28)"
RUN curl --fail --location --retry 3 \
      "${NODE_SOURCE_URL}" \
      --output node.tar.xz \
 && printf '%s  %s\n' "${NODE_SOURCE_SHA256}" node.tar.xz | sha256sum --check --strict \
 && tar -xJf node.tar.xz \
 && cd "node-v${NODE_VERSION}" \
 && CC=gcc CXX=g++ ./configure \
      --prefix=/opt/sagejs-node \
      --partly-static \
      --v8-enable-temporal-support \
 && make -j"$(nproc)" \
 && make -j"$(nproc)" install \
 && strip /opt/sagejs-node/bin/node \
 && /opt/sagejs-node/bin/node --version \
 && /opt/sagejs-node/bin/node -e \
      'if (typeof Temporal !== "object") throw new Error("Temporal is unavailable")'

FROM scratch AS node-artifact
COPY --from=node-build /opt/sagejs-node/bin/node /release-inputs/node

FROM ${BUILD_IMAGE} AS sagejs-build
ARG NODE_SOURCE_FILENAME
ARG NODE_SOURCE_SHA256
ARG NODE_SOURCE_URL
ARG NODE_VERSION
ARG PNPM_TARBALL_SHA512
ARG PNPM_TARBALL_URL
ARG RUST_SOURCE_FILENAME
ARG RUST_SOURCE_SHA256
ARG RUST_SOURCE_URL
ARG RUST_TARGET
ARG RUST_VERSION
COPY --from=node-build /opt/sagejs-node /opt/sagejs-node
ENV PATH=/opt/sagejs-node/bin:/opt/rh/gcc-toolset-14/root/usr/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ENV CC=gcc
ENV CXX=g++
ENV LDFLAGS="-static-libgcc -static-libstdc++"
ENV SAGEJS_NATIVE_MATH_PROFILE=portable
ENV SAGEJS_FLINT_PREFIX=/opt/sagejs-native/flint
ENV SAGEJS_FFLAS_PREFIX=/opt/sagejs-native/fflas
ENV SAGEJS_GRAPH_PREFIX=/opt/sagejs-native/graph
ENV SAGEJS_M4RI_PREFIX=/opt/sagejs-native/m4ri
ENV LC_ALL=C
ENV SOURCE_DATE_EPOCH=0
ENV TZ=UTC
WORKDIR /work/sagejs
COPY sagejs.tar /tmp/sagejs.tar
RUN tar -xf /tmp/sagejs.tar -C /work/sagejs \
 && curl --fail --location --retry 3 "${PNPM_TARBALL_URL}" --output /tmp/pnpm.tgz \
 && printf '%s  %s\n' "${PNPM_TARBALL_SHA512}" /tmp/pnpm.tgz \
      | sha512sum --check --strict \
 && mkdir -p /opt/sagejs-pnpm \
 && tar -xzf /tmp/pnpm.tgz --strip-components=1 -C /opt/sagejs-pnpm \
 && ln -s /opt/sagejs-pnpm/bin/pnpm.mjs /usr/local/bin/pnpm \
 && pnpm --version | grep -Fx '11.9.0' \
 && pnpm install --frozen-lockfile \
 && pnpm run build \
 && pnpm --dir packages/flint build \
 && pnpm --dir packages/fflas build \
 && pnpm --dir packages/graph build \
 && pnpm --dir packages/m4ri build \
 && pnpm run python:precompile:run \
 && pnpm run native:precompile:production \
 && SAGEJS_SEA_NODE=/opt/sagejs-node/bin/node \
      SAGEJS_SEA_NODE_SOURCE_FILENAME="${NODE_SOURCE_FILENAME}" \
      SAGEJS_SEA_NODE_SOURCE_SHA256="${NODE_SOURCE_SHA256}" \
      SAGEJS_SEA_NODE_SOURCE_URL="${NODE_SOURCE_URL}" \
      SAGEJS_SEA_NODE_SOURCE_VERSION="${NODE_VERSION}" \
      SAGEJS_SEA_NODE_RUST_FILENAME="${RUST_SOURCE_FILENAME}" \
      SAGEJS_SEA_NODE_RUST_SHA256="${RUST_SOURCE_SHA256}" \
      SAGEJS_SEA_NODE_RUST_TARGET="${RUST_TARGET}" \
      SAGEJS_SEA_NODE_RUST_URL="${RUST_SOURCE_URL}" \
      SAGEJS_SEA_NODE_RUST_VERSION="${RUST_VERSION}" \
      node scripts/build-sea.cjs --all \
 && node test/sea-smoke.cjs \
 && mkdir -p /release-inputs/addons /release-inputs/sea \
 && node -e 'process.stdout.write(JSON.stringify(require("./scripts/native-math-profile.cjs").nativeMathBuildProfile(), null, 2) + "\\n")' \
      > /release-inputs/native-math-profile.json \
 && find packages dist node_modules -type f -name '*.node' -print0 \
      | sort -z \
      | while IFS= read -r -d '' addon; do \
          name=$(printf '%s' "$addon" | sha256sum | cut -c1-16); \
          cp "$addon" "/release-inputs/addons/${name}-$(basename "$addon")"; \
        done \
 && cp build/sea/sagejs build/sea/sagepython \
      build/sea/sagejs-build-manifest.json \
      build/sea/sagepython-build-manifest.json \
      /release-inputs/sea/ \
 && cp /opt/sagejs-node/bin/node /release-inputs/node

FROM scratch AS release-inputs
COPY --from=sagejs-build /release-inputs /release-inputs
