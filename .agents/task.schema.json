{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sagemathinc/sagejs/blob/main/.agents/task.schema.json",
  "title": "Sage.js parallel project contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "lane",
    "status",
    "owner",
    "objective",
    "base_commit",
    "claims",
    "dependencies",
    "references",
    "architecture",
    "platforms",
    "validation",
    "runs",
    "handoff"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 2 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "title": { "type": "string", "minLength": 4 },
    "lane": {
      "enum": [
        "compiler-runtime",
        "arithmetic-algebra",
        "elliptic-curves",
        "hyperelliptic-curves",
        "modular-forms",
        "symbolic",
        "graphics",
        "combinatorics-groups",
        "polyglot",
        "documentation-compat",
        "native-compiler",
        "distribution",
        "integration"
      ]
    },
    "status": { "enum": ["proposed", "active", "review", "blocked", "complete"] },
    "owner": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 12 },
    "base_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "claims": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "references": { "type": "array", "items": { "type": "string" } },
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "fallback", "oracles", "exceptions"],
      "properties": {
        "strategy": {
          "enum": [
            "dynamic-python",
            "source-transparent-native",
            "external-library",
            "native-primitive",
            "mixed",
            "compiler-infrastructure",
            "not-applicable"
          ]
        },
        "fallback": {
          "enum": ["same-source", "tested-capability", "not-applicable"]
        },
        "oracles": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "exceptions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 20 }
        }
      }
    },
    "platforms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["linux-x64", "linux-arm64", "windows-x64", "macos-arm64"],
      "properties": {
        "linux-x64": { "$ref": "#/$defs/platformPolicy" },
        "linux-arm64": { "$ref": "#/$defs/platformPolicy" },
        "windows-x64": { "$ref": "#/$defs/platformPolicy" },
        "macos-arm64": { "$ref": "#/$defs/platformPolicy" }
      }
    },
    "validation": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "result",
          "exit_code",
          "seconds",
          "started_at",
          "commit",
          "workspace_fingerprint",
          "platform"
        ],
        "properties": {
          "command": { "type": "string" },
          "result": { "enum": ["pass", "fail"] },
          "exit_code": { "type": "integer" },
          "seconds": { "type": "number", "minimum": 0 },
          "started_at": { "type": "string", "format": "date-time" },
          "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "workspace_fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "platform": { "type": "string" }
        }
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "risks", "next_steps"],
      "properties": {
        "summary": { "type": "string" },
        "risks": { "type": "array", "items": { "type": "string" } },
        "next_steps": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "platformPolicy": {
      "enum": ["required", "fallback", "not-applicable"]
    }
  }
}
