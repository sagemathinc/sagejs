  "handoff": {
    "summary": "Size pressure now treats minAgeDays as a preferred grace window instead of an absolute retention guarantee: it removes older obsolete generations first, then recent obsolete generations as needed, while current, newest retained, pinned, and leased generations remain hard protections. Manual and bounded automatic cleanup are covered entirely by temporary-cache tests.",
    "risks": [
      "The cache can remain above maxBytes when hard-protected generations alone exceed the target; this is intentional and reported as best effort."
    ],
