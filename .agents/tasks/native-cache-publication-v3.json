  "handoff": {
    "summary": "Publishes native compiler ABI and exact FFI declaration identities in every schema-v3 production kernel record. The production suite ratchets the duplicated runtime and C-backend ABI constants, verifies index/wrapper metadata agreement and current resource-kernel autoload, and proves that source-identical artifacts forged with stale FFI or compiler ABI metadata fail closed before native registration in permissive and required modes.",
    "risks": [
      "Schema-v1 and schema-v2 native cache indexes intentionally invalidate and fall back or rebuild after this compatibility boundary changes.",
      "Schema-v3 records require backends used by declared compiled kernels to publish the generated __sagejs_ffi_manifest__ declaration identity."
    ],
    "next_steps": [
      "Rebuild and republish production native artifacts whenever the compiler ABI or an imported FFI declaration identity changes."
    ]
  }
